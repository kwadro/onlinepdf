{% form_theme ContactFormType 'bootstrap_5_layout.html.twig' %}
<div class="container container__contact" >
    <section class="d-flex flex-wrap justify-content-left py-3 mb-4 border-bottom">
        <h1 class="w-100 mb-4">{{ 'Contact'|trans }}</h1>
    </section>
    <section class="d-flex flex-wrap justify-content-left py-3 mb-4 ">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {{ form_start(ContactFormType) }}
                    {{ form_row(ContactFormType.full_name , {'attr': {'class': 'mb-1 form-control name'}}) }}
                    {{ form_row(ContactFormType.email, {'attr': {'class': 'mb-1 form-control email'}}) }}
                    {{ form_row(ContactFormType.message,{'attr': {'class': 'mb-1 form-control message'}}) }}
                    <button type="submit" class="mt-3 btn btn-primary">{{'Send Message'|trans }}</button>
                    {{ form_end(ContactFormType) }}
                </div>
            </div>
        </div>
    </section>
</div>


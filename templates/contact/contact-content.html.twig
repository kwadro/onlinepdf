{% form_theme ContactFormType 'bootstrap_5_layout.html.twig' %}
<div class="page-content page-content--contact">
    <section class="page-hero page-hero--contact">
        <div class="page-hero__icon" aria-hidden="true">
            <i class="bi bi-envelope"></i>
        </div>
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ 'Contact'|trans }}</h1>
            <p class="page-hero__subtitle">{{ 'page.contact_intro'|trans }}</p>
        </div>
    </section>

    <div class="page-card page-card--form">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success page-alert" role="alert">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger page-alert" role="alert">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(ContactFormType, {
            attr: {
                class: 'page-form',
                'data-controller': 'contact-recaptcha',
                'data-contact-recaptcha-site-key-value': recaptcha_site_key,
                'data-contact-recaptcha-action-value': 'contact',
                'data-turbo': 'false',
            },
        }) }}
            <div class="page-form__grid">
                {{ form_row(ContactFormType.full_name, {
                    label: 'Full name'|trans,
                    attr: { class: 'form-control page-form__control', placeholder: 'Full name'|trans },
                }) }}
                {{ form_row(ContactFormType.email, {
                    label: 'Email'|trans,
                    attr: { class: 'form-control page-form__control', placeholder: 'Email'|trans },
                }) }}
            </div>
            {{ form_row(ContactFormType.message, {
                label: 'Message'|trans,
                attr: { class: 'form-control page-form__control page-form__textarea', rows: 6, placeholder: 'Message'|trans },
            }) }}
            <input
                type="hidden"
                name="recaptcha_token"
                id="recaptcha_token"
                data-contact-recaptcha-target="token"
            >
            <div class="page-form__actions">
                <button type="submit" class="btn btn-primary page-form__submit">
                    <i class="bi bi-send me-2"></i>{{ 'Send Message'|trans }}
                </button>
            </div>
        {{ form_end(ContactFormType) }}
    </div>
</div>

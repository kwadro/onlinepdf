{% extends 'base.html.twig' %}

{% block title %}{{ 'Register'|trans }}{% endblock %}

{% form_theme registrationForm 'bootstrap_5_layout.html.twig' %}

{% block main %}
<div class="page-content page-content--auth">
    <section class="page-hero page-hero--auth">
        <div class="page-hero__icon" aria-hidden="true">
            <i class="bi bi-person-plus"></i>
        </div>
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ 'Register'|trans }}</h1>
            <p class="page-hero__subtitle">{{ 'auth.register_intro'|trans }}</p>
        </div>
    </section>

    <div class="page-card page-card--form auth-card">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger page-alert" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {% for flash_success in app.flashes('success') %}
            <div class="alert alert-success page-alert" role="alert">{{ flash_success }}</div>
        {% endfor %}

        {{ form_start(registrationForm, { attr: { class: 'page-form auth-form' } }) }}
            {{ form_errors(registrationForm) }}

            <div class="page-form__grid auth-form__grid">
                {{ form_row(registrationForm.first_name, {
                    label: 'First name'|trans,
                    attr: { class: 'form-control page-form__control first_name' },
                }) }}
                {{ form_row(registrationForm.last_name, {
                    label: 'Last name'|trans,
                    attr: { class: 'form-control page-form__control last_name' },
                }) }}
            </div>

            {{ form_row(registrationForm.email, {
                label: 'Email'|trans,
                attr: { class: 'form-control page-form__control email' },
            }) }}

            {{ form_row(registrationForm.plainPassword, {
                label: 'Password'|trans,
                attr: { class: 'form-control page-form__control password' },
            }) }}

            {{ form_row(registrationForm.agreeTerms, {
                row_attr: { class: 'auth-form__terms' },
                attr: { class: 'form-check-input' },
                label_attr: { class: 'form-check-label' },
            }) }}

            <div class="page-form__actions auth-form__actions">
                <button type="submit" class="btn btn-primary page-form__submit auth-form__submit">
                    <i class="bi bi-person-plus me-2"></i>{{ 'Register'|trans }}
                </button>
            </div>
        {{ form_end(registrationForm) }}

        {% include 'security/_auth-divider.html.twig' with { label: 'OR' } %}
        {% include 'security/_auth-social.html.twig' with { mode: 'register' } %}

        <div class="auth-switch">
            <p class="auth-switch__text mb-0">{{ 'If you have an account?'|trans }}</p>
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary auth-switch__link">
                {{ 'Sign in'|trans }}
            </a>
        </div>
    </div>
</div>
{% endblock %}

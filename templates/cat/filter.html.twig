<h4 class="mb-0">{{ 'Filter'|trans }}</h4>
<div class="container my-2">
    <span class="fw-bold mb-0 d-inline-block">{{ 'Categories : '|trans }}</span>
    {% if categories is not empty %}
        {% for category in categories %}
            <span class="category-badge mb-0 d-inline-block"
                  data-categoryid="{{category.id}}"
            >
                {{category.name}}
                <button type="button"
                        class="badge-remove"
                        data-action="click->filter#closeCategory"
                        aria-label="Remove">
                    ×
                </button>
            </span>
        {% endfor %}
    {% else %}
        <span class="category-badge mb-0 d-inline-block">{{ 'All categories'|trans }}</span>
    {% endif %}
    <span class="ms-2 fw-bold mb-0 d-inline-block">{{ 'Authors : '|trans }}</span>
    {% if authors is not empty %}
        {% for author in authors %}
            <span class="category-badge mb-0 d-inline-block"
                  data-authorid="{{author.id}}"
            >
                {{author.name}}
                <button type="button"
                        class="badge-remove"
                        data-action="click->filter#closeAuthor"
                        aria-label="Remove">
                    ×
                </button>
            </span>
        {% endfor %}
    {% else %}
        <span class="category-badge mb-0 d-inline-block">{{ 'All authors'|trans }}</span>
    {% endif %}
</div>

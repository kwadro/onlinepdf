{% if popularSearchWords is not empty %}
     <div class="width-search d-flex justify-content-between align-items-center">
         <h5 class="fw-bold ms-2 my-3">{{'Popular search terms'|trans}}</h5>
{#         <small class="text-muted me-3 my-3">{{'Updated'|trans}} 23:35</small>#}
     </div>
     <div class="row g-3 width-search" data-controller="popularsearch">
         {% for popularSearch in popularSearchWords %}
             {% if popularSearch.image %}
                 {% set popularSearchImage = '/uploads/recipes/' ~ popularSearch.image %}
             {% else %}
                 {% set popularSearchImage = 'https://placehold.in/200' %}
             {% endif %}
             <div class="col-6 col-md-3 ">
                 <div
                     data-action="click->popularsearch#open"
                     class="keyword-card d-block"
                     data-popularsearch-query-url-value="{{ path('search_page',{'keyword':popularSearch.name})  }}"
                 >
                     <img src="{{ popularSearchImage }}" width="230" class="img-fluid" alt="">
                     <span class="keyword-title">{{ popularSearch.name }}</span>
                 </div>
             </div>
         {% endfor %}
     </div>
{% endif %}

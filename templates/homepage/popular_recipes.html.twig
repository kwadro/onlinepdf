{% if recipes is not empty %}
<div class="width-search d-flex justify-content-between align-items-center">
    <h4 class="fw-bold ms-2 my-3">{{'Popular recipes'|trans}}</h4>
</div>
    {% include "homepage/recipe-grid.html.twig" with {
        'recipes': recipes,
        'favoriteIds': favoriteIds
    } %}
{% else %}
    <h5 class="text-center">{{ 'We not found any recipe'|trans }}</h5>
{% endif %}


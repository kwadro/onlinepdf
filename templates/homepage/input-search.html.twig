<input id="search_form" type="hidden" name="_token" value="{{ csrf_token_search }}">
<div class="input-group search-box">
    <div class="input-search-text">
        <i class="bi bi-search"></i>
        <input
            id="search-input"
            type="search"
            value="{{ keyword }}"
            class="form-control"
            data-baseurl="{{ url('search_page', { keyword: 'keyword' }) }}"
            placeholder="{{ 'search_placeholder'|trans }}"
        >
    </div>
    <button
        class="btn btn-primary px-4"
        data-action="click->search#open"
        type="button">
        {{ 'Find a recipe'|trans }}
    </button>
</div>

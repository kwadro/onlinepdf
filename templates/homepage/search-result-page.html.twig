{% extends "base.html.twig" %}
{% block main %}

    <div class="d-flex justify-content-center mt-3 p-3">
        {% include "homepage/input-search.html.twig" with {
            'csrf_token_search': csrf_token_search,
            'keyword': keyword|default('')
        } %}
    </div>
    <div class="width-search d-flex justify-content-between align-items-center">
        <h4 class="fw-bold ms-2 my-3">{{'Search result for request'|trans}} "{{ keyword}}" ( {{ recipes|length }} )</h4>
    </div>
    <div class="product-grid">
        {% if recipes is not empty %}
            <!-- Recipe Grid -->
            {% include "homepage/recipe-grid.html.twig" with {
                'recipes': recipes,
                'favoriteIds': favoriteIds,
                'countRepeat': 1
            } %}
        {% else %}
            <h5 class="text-center">{{ 'We not found any recipe'|trans }}</h5>
        {% endif %}
    </div>
    {% include "homepage/block-popular_recipes.html.twig" with {
        'recipes': popularRecipes,
        'favoriteIds': favoriteIds
    } %}

    {% include "homepage/block-recently_recipes.html.twig" with {
        'recipes': recentlyRecipes,
        'favoriteIds': favoriteIds
    } %}

{% endblock %}

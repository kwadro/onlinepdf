{% set setting = site_settings() %}
<ul
    class="list-group  mt-4"
    data-controller="sidebar"
>
    {% for item_menu in setting.menu %}
         {% if  item_menu.megamenutype =='Sidebar'%}
            <li  class="list-group-item  border-0 mx-1 mega-left-item
                 {% if loop.first %}active fw-semibold{% endif %}"
                 data-target="sidebar-{{ loop.index }}">
                <div class="d-flex align-center">
                    {{ item_menu.content|raw }}
                    <a class="d-block lh-1 fw-semibold fs-5 text-decoration-none text-dark py-1 px-2"
                       href="{{ absolute_url(path(item_menu.url)) }}">
                        {{ item_menu.name }}
                    </a>
                </div>
            </li>
         {% endif %}
    {% endfor %}
</ul>

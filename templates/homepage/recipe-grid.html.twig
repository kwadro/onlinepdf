    <div class="width-search row g-4">
        {% set countRepeatVal = countRepeat|default('4') %}
        {% if recipes is not empty %}
            {% for i in 1..countRepeatVal %}
            {% for recipe in recipes %}
                <div class="col-md-3">
                    <div class="product-card shadow-sm">
                        <div class="position-relative">
                            {% if recipe.image %}
                                {% set recipeimage = '/uploads/recipes/' ~ recipe.image %}
                            {% else %}
                                {% set recipeimage = 'https://placehold.in/200' %}
                            {% endif %}
                            <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}">
                                <img src="{{ recipeimage }}" class="product-image w-100" alt="{{ recipe.recipetranslations[0].name }}"/>
                            </a>

                            <span class="discount-badge">New</span>
                            <button class="wishlist-btn">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>
                        <div class="p-3">
                            {% if recipes is not empty %}
                                {% for category in recipe.recipecategorys %}
                                    <span class="category-badge mb-2 d-inline-block">{{ category.name }}</span>
                                {% endfor %}
                            {% endif %}
                            <h6 class="mb-1">{{ recipe.recipetranslations[0].name }}</h6>
                            <div class="my-2 d-flex justify-content-start gap-2 align-items-center">
                                            <span data-bs-toggle="tooltip" title="{{ 'Prepare time'|trans }}">
                                                <i class="me-1 bi bi-clock"></i>{{ recipe.prepTimeMin }} {{ 'minutes'|trans }}
                                            </span>
                                <span data-bs-toggle="tooltip" title="{{ 'Cook time'|trans }}">
                                                <i class="me-1 bi bi-fire"></i>{{ recipe.cookTimeMin }} {{ 'minutes'|trans }}
                                            </span>
                                <span data-bs-toggle="tooltip" title="{{ 'Servings'|trans }}">
                                                <i class="me-1 bi bi-people"></i>{{ recipe.servings }}
                                            </span>

                            </div>
                            <div class="d-flex flex-column gap-2 justify-content-between align-items-start">
                                <div class="flex-row small">
                                    <span>{{ 'Author'|trans }}</span>
                                    <a href="{{ path('author_list', {id: recipe.recipetranslations[0].recipeauthor.id}) }}" class="btn btn-sm btn-secondary">
                                        {{ recipe.recipetranslations[0].recipeauthor }}
                                    </a>
                                </div>
                                <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}" class="btn btn-sm btn-primary w-100">
                                    {{ 'View'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
            {% endfor %}
        {% else %}
            <h5 class="text-center">{{ 'We not found any recipe in this category'|trans }}</h5>
        {% endif %}
    </div>

<div class="home-recipe-grid width-search row g-4">
    {% set countRepeatVal = countRepeat|default('1') %}
    {% set favoriteIds = favoriteIds|default([]) %}
    {% set newIds = newIds|default([]) %}
    {% if recipes is not empty %}
        {% for i in 1..countRepeatVal %}
            {% for recipe in recipes %}
                <div class="col-xl-3 col-lg-4 col-md-4 col-sm-6 col-12">
                    <article class="home-recipe-card product-card">
                        <div class="home-recipe-card__media position-relative">
                            {% if (favoriteIds is not empty) and (recipe.id in favoriteIds) %}
                                {% set favoriteClass = 'selected' %}
                            {% else %}
                                {% set favoriteClass = '' %}
                            {% endif %}

                            {% if recipe.image %}
                                {% set recipeimage = '/uploads/recipes/' ~ recipe.image %}
                            {% else %}
                                {% set recipeimage = 'https://placehold.in/200' %}
                            {% endif %}

                            <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}" class="home-recipe-card__image-link">
                                <img src="{{ recipeimage }}" class="product-image home-recipe-card__image w-100" alt="{{ recipe.recipetranslations[0].name }}"/>
                            </a>

                            {% if (newIds is not empty) and (recipe.id in favoriteIds) %}
                                <span class="discount-badge home-recipe-card__badge">{{ 'New'|trans }}</span>
                            {% endif %}

                            <button
                                title="{{ 'Add to Favorite List'|trans }}"
                                class="favorite-btn home-recipe-card__favorite {{ favoriteClass }}"
                                data-id="{{ recipe.id }}"
                                data-add="{{ path('account_wishlist_add') }}"
                                data-remove="{{ path('account_wishlist_remove') }}"
                                data-action="click->scroll#addFavoriteItem"
                            >
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>
                        <div class="home-recipe-card__body">
                            {% if recipes is not empty %}
                                {% for category in recipe.recipecategorys %}
                                    <span class="category-badge home-recipe-card__category">{{ category.name }}</span>
                                {% endfor %}
                            {% endif %}

                            <h3 class="recipe-name home-recipe-card__title">{{ recipe.recipetranslations[0].name }}</h3>

                            {% include "recipe/block-info-time.html.twig" with {
                                recipe: recipe,
                                class: 'recipe-info home-recipe-card__meta',
                            } %}

                            <div class="home-recipe-card__footer">
                                {% include "author/block-info-author-full.html.twig" with {
                                    recipe: recipe,
                                } %}

                                <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}" class="btn btn-sm btn-primary home-recipe-card__cta w-100">
                                    {{ 'View'|trans }}
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            {% endfor %}
        {% endfor %}
    {% else %}
        <div class="home-empty">
            <h5 class="home-empty__title">{{ 'We not found any recipe in this category'|trans }}</h5>
        </div>
    {% endif %}
</div>

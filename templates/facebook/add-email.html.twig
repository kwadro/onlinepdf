{% set setting = site_settings() %}
{% extends "base.html.twig" %}
{% block main %}
<div class="container container__contact" >
    <section class="d-flex flex-wrap justify-content-left py-3 mb-4 border-bottom">
        <h4 class="w-100 mb-1">{{ 'We were unable to read the email associated with your Facebook account'|trans }}</h4>
        <h4 class="w-100 mb-4">{{ 'Set up your email'|trans }}</h4>
    </section>
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <section class="d-flex flex-wrap justify-content-left py-3 mb-4 ">
        <div class="container">
            <div class="row justify-content-center">
                {{ form_start(formEmail) }}
                    {{ form_row(formEmail.email,{'attr': {'class': 'mb-1 form-control email'}}) }}
                    <input type="hidden" name="facebook_email_form_token" id="facebook_email_form_token">
                    <button type="submit" class="mt-3 btn btn-primary">{{'Save Email'|trans }}</button>
                {{ form_end(formEmail) }}
            </div>
        </div>
    </section>
</div>

{% endblock %}

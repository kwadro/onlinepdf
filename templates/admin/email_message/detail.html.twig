{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% set email = entity.instance %}
{% set senderName = email.fromName|default('')|trim %}
{% set senderAddress = email.fromAddress|default('')|trim %}
{% set senderInitial = (senderName ?: senderAddress)|slice(0, 1)|upper %}
{% set replySubject = 'Re: ' ~ (email.subject|default('')) %}
{% set forwardSubject = 'Fwd: ' ~ (email.subject|default('')) %}
{% set quoteFrom = senderName ?: senderAddress %}
{% set quoteDate = email.receivedAt ? email.receivedAt|date('d.m.Y, H:i') : '' %}
{% set replyToDisplay = senderAddress ? (quoteFrom ~ ' (' ~ senderAddress ~ ')') : quoteFrom %}

{% set replyQuoteHtml %}
<div class="email-quote">
    <p>{{ 'email.view.on_date_wrote'|trans({'%date%': quoteDate, '%from%': quoteFrom}) }}</p>
    <blockquote style="margin:0 0 0 12px;padding-left:12px;border-left:2px solid #dadce0;color:#5f6368;">
        {{ email.bodyHtml|default('')|raw }}
    </blockquote>
</div>
{% endset %}

{% set forwardQuoteHtml %}
<div class="email-quote">
    <p>{{ 'email.view.forwarded_message'|trans({}, 'messages') }}</p>
    <p>{{ 'email.view.from'|trans({}, 'messages') }}: {{ quoteFrom|e }}{% if senderAddress %} &lt;{{ senderAddress|e }}&gt;{% endif %}<br>
    {{ 'email.view.date'|trans({}, 'messages') }}: {{ quoteDate|e }}<br>
    {{ 'email.view.subject'|trans({}, 'messages') }}: {{ email.subject|default('')|e }}</p>
    <blockquote style="margin:0 0 0 12px;padding-left:12px;border-left:2px solid #dadce0;color:#5f6368;">
        {{ email.bodyHtml|default('')|raw }}
    </blockquote>
</div>
{% endset %}

{% block content_title %}
    {{ email.subject|default('email.view.no_subject'|trans({}, 'messages'))|e }}
{% endblock %}

{% block main %}
    <article class="email-viewer">
        <header class="email-viewer__header">
            <h1 class="email-viewer__subject">
                {{ email.subject|default('email.view.no_subject'|trans({}, 'messages'))|e }}
            </h1>

            <div class="email-viewer__meta">
                <div class="email-viewer__avatar" aria-hidden="true">{{ senderInitial ?: '?' }}</div>

                <div class="email-viewer__meta-content">
                    <div class="email-viewer__row">
                        <span class="email-viewer__label">{{ 'email.view.from'|trans({}, 'messages') }}</span>
                        <span class="email-viewer__value">
                            {% if senderName %}
                                <strong>{{ senderName|e }}</strong>
                                {% if senderAddress %}
                                    <span class="email-viewer__muted">&lt;{{ senderAddress|e }}&gt;</span>
                                {% endif %}
                            {% elseif senderAddress %}
                                <strong>{{ senderAddress|e }}</strong>
                            {% else %}
                                <span class="email-viewer__muted">—</span>
                            {% endif %}
                        </span>
                    </div>

                    {% if email.recipient %}
                        <div class="email-viewer__row">
                            <span class="email-viewer__label">{{ 'email.view.to'|trans({}, 'messages') }}</span>
                            <span class="email-viewer__value">{{ email.recipient|e }}</span>
                        </div>
                    {% endif %}

                    {% if email.receivedAt %}
                        <div class="email-viewer__row">
                            <span class="email-viewer__label">{{ 'email.view.date'|trans({}, 'messages') }}</span>
                            <span class="email-viewer__value">{{ email.receivedAt|date('d.m.Y, H:i') }}</span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </header>

        <div class="email-viewer__body">
            {% if email.bodyHtml %}
                <iframe
                    class="email-viewer__iframe"
                    title="{{ 'email.view.body'|trans({}, 'messages') }}"
                    sandbox="allow-same-origin"
                    srcdoc="{{ email.bodyHtml|e('html_attr') }}"
                ></iframe>
            {% else %}
                <p class="email-viewer__empty">{{ 'email.view.no_content'|trans({}, 'messages') }}</p>
            {% endif %}
        </div>

        <footer class="email-viewer__actions">
            {% if senderAddress %}
                <button type="button" class="email-viewer__action-btn" data-compose-open="reply">
                    <svg class="email-viewer__action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 9V5L3 12l7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-8.9-11-8.9z"/>
                    </svg>
                    <span>{{ 'email.view.reply'|trans({}, 'messages') }}</span>
                </button>
            {% else %}
                <span class="email-viewer__action-btn email-viewer__action-btn--disabled" title="{{ 'email.view.reply_unavailable'|trans({}, 'messages') }}">
                    <svg class="email-viewer__action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 9V5L3 12l7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-8.9-11-8.9z"/>
                    </svg>
                    <span>{{ 'email.view.reply'|trans({}, 'messages') }}</span>
                </span>
            {% endif %}

            <button type="button" class="email-viewer__action-btn" data-compose-open="forward">
                <svg class="email-viewer__action-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14 4v4.1c5 0 8.5 1.6 11 5.1-1-5-4-8.9-11-8.9V4l-7 7 7 7z"/>
                </svg>
                <span>{{ 'email.view.forward'|trans({}, 'messages') }}</span>
            </button>
        </footer>

        <div id="email-compose" class="email-compose" hidden>
            <div class="email-compose__panel">
                <form class="email-compose__form" data-compose-form>
                    <header class="email-compose__inline-header">
                        <svg class="email-compose__mode-icon email-compose__mode-icon--reply" data-compose-mode-icon-reply viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M10 9V5L3 12l7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-8.9-11-8.9z"/>
                        </svg>
                        <svg class="email-compose__mode-icon email-compose__mode-icon--forward" data-compose-mode-icon-forward viewBox="0 0 24 24" aria-hidden="true" hidden>
                            <path d="M14 4v4.1c5 0 8.5 1.6 11 5.1-1-5-4-8.9-11-8.9V4l-7 7 7 7z"/>
                        </svg>

                        <div class="email-compose__header-fields">
                            <div class="email-compose__recipient-row">
                                <span class="email-compose__recipient-text" data-compose-recipient-text>{{ replyToDisplay|e }}</span>
                                <input
                                    id="email-compose-to"
                                    class="email-compose__input email-compose__input--to"
                                    type="email"
                                    data-compose-to
                                    placeholder="{{ 'email.view.recipients'|trans({}, 'messages') }}"
                                    required
                                >
                            </div>

                            <div class="email-compose__subject-row" data-compose-subject-row hidden>
                                <span class="email-compose__label">{{ 'email.view.subject'|trans({}, 'messages') }}</span>
                                <input
                                    id="email-compose-subject"
                                    class="email-compose__input email-compose__input--subject"
                                    type="text"
                                    data-compose-subject
                                    required
                                >
                            </div>
                        </div>
                    </header>

                    <div class="email-compose__editor-wrap">
                        <div class="email-compose__editor">
                            <textarea id="email-compose-body" name="body"></textarea>
                        </div>

                        <button type="button" class="email-compose__quote-toggle" data-compose-quote-toggle hidden aria-expanded="false">
                            <span aria-hidden="true">•••</span>
                            <span class="visually-hidden">{{ 'email.view.show_quote'|trans({}, 'messages') }}</span>
                        </button>

                        <div class="email-compose__quote" data-compose-quote hidden></div>
                    </div>

                    <footer class="email-compose__footer">
                        <div class="email-compose__footer-left">
                            <button type="submit" class="email-compose__send" data-compose-send>
                                {{ 'email.view.send'|trans({}, 'messages') }}
                            </button>

                            <button type="button" class="email-compose__tool-btn" data-compose-format title="{{ 'email.view.formatting'|trans({}, 'messages') }}">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4v3h5.5v12h3V7H19V4z"/></svg>
                            </button>

                            <button type="button" class="email-compose__tool-btn" data-compose-link title="{{ 'email.view.insert_link'|trans({}, 'messages') }}">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
                            </button>
                        </div>

                        <div class="email-compose__footer-right">
                            <span class="email-compose__status" data-compose-status></span>
                            <button type="button" class="email-compose__tool-btn email-compose__tool-btn--discard" data-compose-discard title="{{ 'email.view.discard'|trans({}, 'messages') }}">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                            </button>
                        </div>
                    </footer>
                </form>
            </div>
        </div>
    </article>

    {% set composeConfig = {
        replyUrl: path('admin_email_message_reply', {id: email.id, _locale: app.request.locale}),
        csrfToken: csrf_token('email_reply'),
        replyTo: senderAddress,
        replyToDisplay: replyToDisplay,
        replySubject: replySubject,
        forwardSubject: forwardSubject,
        replyQuoteHtml: replyQuoteHtml|trim,
        forwardQuoteHtml: forwardQuoteHtml|trim,
        labels: {
            reply: 'email.view.reply'|trans({}, 'messages'),
            forward: 'email.view.forward'|trans({}, 'messages'),
            sending: 'email.view.sending'|trans({}, 'messages'),
            sendSuccess: 'email.view.send_success'|trans({}, 'messages'),
            sendError: 'email.view.send_error'|trans({}, 'messages'),
        },
    } %}
    <script type="application/json" id="email-compose-config">{{ composeConfig|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
        document.querySelectorAll('.email-viewer__iframe').forEach((iframe) => {
            iframe.addEventListener('load', () => {
                try {
                    const doc = iframe.contentDocument;
                    if (!doc) {
                        return;
                    }

                    const style = doc.createElement('style');
                    style.textContent = `
                        html, body {
                            margin: 0;
                            padding: 16px;
                            background: #fff;
                            color: #202124;
                            font: 14px/1.5 Arial, Helvetica, sans-serif;
                            word-wrap: break-word;
                            overflow-wrap: anywhere;
                        }
                        img { max-width: 100%; height: auto; }
                        table { max-width: 100%; }
                        a { color: #1a73e8; }
                        blockquote {
                            margin: 0 0 0 12px;
                            padding-left: 12px;
                            border-left: 2px solid #dadce0;
                            color: #5f6368;
                        }
                    `;
                    doc.head.appendChild(style);

                    iframe.style.height = Math.max(doc.body.scrollHeight, doc.documentElement.scrollHeight) + 'px';
                } catch (error) {
                    iframe.style.minHeight = '320px';
                }
            });
        });
    </script>
{% endblock %}

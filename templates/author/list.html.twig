{% extends "base.html.twig" %}
{% block title %} {{ 'Recipe of author'|trans }} @cook-{{ recipeAuthor.id }} {% endblock %}
{% block main %}
{#    {% include "recipe/breadcrumbs.html.twig" with {#}
{#        breadCrumbs: breadcrumbs#}
{#    } %}#}
    <div class="width-search d-flex justify-content-between align-items-center">
        <h4 class="fw-bold ms-2 my-3">{{ 'Recipe of author'|trans }} {{ recipeAuthor.firstName }} {{ recipeAuthor.lastName }}</h4>
    </div>
    {% if recipes is not empty %}
        {% include "homepage/recipe-grid.html.twig" with {
            'recipes': recipes,
            'newIds': [],
            'favoriteIds': []
        } %}
    {% else %}
        <h5 class="text-center">{{ 'We not found any recipe'|trans }}</h5>
    {% endif %}
{% endblock %}

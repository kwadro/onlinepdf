{% extends 'base.html.twig' %}

{% block title %}{{ recipeCategory.name|default('Categories'|trans) }}{% endblock %}

{% block main %}
<div class="page-content page-content--collection">
    <section class="page-hero page-hero--collection">
        {% if recipeCategory.image %}
            <img
                class="page-collection__image"
                src="/uploads/recipes/{{ recipeCategory.image }}"
                alt="{{ recipeCategory.name }}"
                width="56"
                height="56"
            >
        {% else %}
            <div class="page-hero__icon" aria-hidden="true">
                <i class="bi bi-folder2-open"></i>
            </div>
        {% endif %}
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ recipeCategory.name }}</h1>
            <div class="page-collection__meta">
                <span class="page-collection__count">
                    {{ recipes|length }}
                    {{ recipes|length == 1 ? 'page.search_result_one'|trans : 'page.search_result_many'|trans }}
                </span>
                {% if recipeCategory.children is not empty %}
                    <span class="page-collection__subcount">
                        {{ recipeCategory.children|length }}
                        {{ recipeCategory.children|length == 1 ? 'page.collection_subcategory_one'|trans : 'page.collection_subcategory_many'|trans }}
                    </span>
                {% endif %}
            </div>
        </div>
    </section>

    {% if recipeCategory.children is not empty %}
        <section class="home-section page-collection__categories">
            <div class="home-section__head">
                <h2 class="home-section__title">{{ 'Categories'|trans }}</h2>
            </div>
            <div class="home-section__body">
                <div class="page-collection__category-grid">
                    {% for child in recipeCategory.children %}
                        <a
                            class="page-collection__category-chip"
                            href="{{ path('collection_list', {slug: child.slug, _locale: app.request.locale}) }}"
                        >
                            {{ child.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section class="home-section page-collection__recipes">
        <div class="home-section__head">
            <h2 class="home-section__title">{{ 'List of recipes'|trans }}</h2>
        </div>
        <div class="home-section__body">
            {% if recipes is not empty %}
                {% include 'homepage/recipe-grid.html.twig' with {
                    recipes: recipes,
                    favoriteIds: favoriteIds|default([]),
                    newIds: [],
                } %}
            {% else %}
                <div class="page-empty">
                    <div class="page-empty__icon" aria-hidden="true">
                        <i class="bi bi-journal-x"></i>
                    </div>
                    <h3 class="page-empty__title">{{ 'We not found any recipe in this category'|trans }}</h3>
                    <p class="page-empty__text">{{ 'page.collection_empty_hint'|trans }}</p>
                </div>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}

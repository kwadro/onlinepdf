{% extends "base.html.twig" %}
{% block title %}{{ 'Wish List' | trans }}{% endblock %}
{% block main %}
    <div class="width-search d-flex justify-content-between align-items-center">
        <h4 class="fw-bold ms-2 my-3">{{'Favorite List'|trans}}</h4>
    </div>
    {% if recipes is not empty %}
        {% include "homepage/recipe-grid.html.twig" with {
            'recipes': recipes,
            'newIds': newIds,
            'favoriteIds': favoriteIds
        } %}
    {% else %}
        <h5 class="text-center">{{ 'We not found any favorite recipe'|trans }}</h5>
    {% endif %}
{% endblock %}

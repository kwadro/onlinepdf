{% extends "base.html.twig" %}
{% block title %}{{ recipe.recipetranslations[0].name }}{% endblock %}
{% block main %}
{#    {% include "recipe/breadcrumbs.html.twig" with {#}
{#        breadCrumbs: breadcrumbs#}
{#    } %}#}
    {% if message is not empty %}
        <div class="px-2 mt-3 d-flex justify-content-start gap-2">
            <div class="alert alert-warning w-100" role="alert">
                {{message|trans}}
            </div>
        </div>
    {% endif %}
    <div class="container my-4">
        <div class="row g-4">
            <!-- Image -->
            <div class="col-12 col-md-4 col-lg-3 text-center">
                {% if recipe.image %}
                    {% set recipeimage = '/uploads/recipes/' ~ recipe.image %}
                {% else %}
                    {% set recipeimage = 'https://placehold.in/200' %}
                {% endif %}
                <img src="{{ recipeimage }}"
                    class="img-fluid rounded shadow-sm"
                    alt="{{ recipe.recipetranslations[0].name }}"
                    title="{{ recipe.recipetranslations[0].name }}"
                >
                {% if recipe.recipetranslations[0].groupcomponents %}
                    <ul class=" ingredients-grid ">
                        {% for groupcomponent in recipe.recipetranslations[0].groupcomponents %}
                            <h4 class="fw-bold my-3">
                                {{ groupcomponent.name }}
                            </h4>
                            {% for component in groupcomponent.components %}
                                <li class="list-group-item  d-flex justify-content-between align-items-center">
                                    {% if component.ingredient %}
                                        <span>{{ component.ingredient.name }}</span>
                                    {% endif %}
                                    <span class="fw-bold">
                                    {% if component.unit.id !== 5 %}
                                        {{ component.quantity }} {{ component.unit }}
                                    {% else %}
                                        {{ component.unit }}
                                    {% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        {% endfor %}
                    </ul>
                {% endif %}

            </div>

            <!-- Content -->
            <div class="col-12 col-md-8 col-lg-9">
                <h1 class="mb-3">{{ recipe.recipetranslations[0].name }}</h1>

                {% include "author/block-info-author-full.html.twig" with {
                    'recipe': recipe
                } %}

                <p class="text-muted mb-4">
                    {{ recipe.recipetranslations[0].description|nl2br }}
                </p>

                {% include "recipe/block-info-time.html.twig" with {
                    'recipe': recipe,
                    'class':'recipe-info full'
                } %}
                {% include "recipe/block-share-content.html.twig" with {
                    'recipe': recipe,
                    'class':'recipe-info full'
                } %}

                <!-- Preparation steps -->
                <h3 class="text-center fw-bold my-4">
                    {{ 'Preparation steps'|trans }}
                </h3>

                <ul class="steps-grid list-group mb-4">
                    {% for step in recipe.recipetranslations[0].recipesteps %}
                        <li class="list-group-item">
                            <div class="d-flex flex-column flex-md-row gap-3">
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold mb-1">
                                        {{ step.name }}
                                    </h5>

                                    {% if step.question %}
                                        <p class="mb-1 text-muted">
                                            {{ step.question|nl2br  }}
                                        </p>
                                    {% endif %}

                                    {% if step.answer %}
                                        <p class="mb-0">
                                            {{ step.answer|nl2br  }}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

            </div>
        </div>


    </div>

{% endblock %}

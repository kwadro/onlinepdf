{% extends "base.html.twig" %}
{% block title %}{{ recipe.recipetranslations[0].name }}{% endblock %}
{% block main %}
<div class="page-content recipe-page">
    {% if message is not empty %}
        <div class="page-alert alert alert-warning" role="alert">
            {{ message|trans }}
        </div>
    {% endif %}

    {% if recipe.image %}
        {% set recipeimage = '/uploads/recipes/' ~ recipe.image %}
    {% else %}
        {% set recipeimage = 'https://placehold.in/200' %}
    {% endif %}

    <article class="recipe-page__layout">
        <aside class="recipe-page__aside">
            <div class="recipe-page__media page-card">
                <img
                    src="{{ recipeimage }}"
                    class="recipe-page__image"
                    alt="{{ recipe.recipetranslations[0].name }}"
                    title="{{ recipe.recipetranslations[0].name }}"
                >
            </div>

            {% if recipe.recipetranslations[0].groupcomponents is not empty %}
                <div class="recipe-page__ingredients page-card">
                    <h2 class="recipe-page__ingredients-heading">{{ 'page.recipe_ingredients'|trans }}</h2>
                    {% for groupcomponent in recipe.recipetranslations[0].groupcomponents %}
                        <div class="recipe-page__ingredient-group">
                            <h3 class="recipe-page__ingredient-group-title">{{ groupcomponent.name }}</h3>
                            <ul class="recipe-page__ingredient-list">
                                {% for component in groupcomponent.components %}
                                    <li class="recipe-page__ingredient-item">
                                        {% if component.ingredient %}
                                            <span class="recipe-page__ingredient-name">{{ component.ingredient.name }}</span>
                                        {% endif %}
                                        <span class="recipe-page__ingredient-qty">
                                            {% if component.textunit is not empty %}
                                                {{ component.textunit }}
                                            {% else %}
                                                {{ component.quantity }}  {{ component.unit }}
                                            {% endif %}
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </aside>

        <div class="recipe-page__main">
            <header class="recipe-page__hero page-hero">
                <div class="recipe-page__hero-copy page-hero__copy">
                    <h1 class="page-hero__title recipe-page__title">{{ recipe.recipetranslations[0].name }}</h1>

                    <div class="recipe-page__author">
                        {% include "author/block-info-author-full.html.twig" with { recipe: recipe } %}
                    </div>

                    {% include "recipe/block-info-time.html.twig" with {
                        recipe: recipe,
                        class: 'recipe-info recipe-page__meta',
                    } %}

                    <div class="recipe-page__share">
                        {% include "recipe/block-share-content.html.twig" with { recipe: recipe } %}
                    </div>
                </div>
            </header>

            {% if recipe.recipetranslations[0].description %}
                <section class="recipe-page__description page-card">
                    <h2 class="recipe-page__section-title">{{ 'page.recipe_description'|trans }}</h2>
                    <div class="recipe-page__description-text">
                        {{ recipe.recipetranslations[0].description|nl2br }}
                    </div>
                </section>
            {% endif %}

            {% if recipe.recipetranslations[0].recipesteps is not empty %}
                <section class="recipe-page__steps">
                    <div class="home-section__head">
                        <h2 class="home-section__title">{{ 'Preparation steps'|trans }}</h2>
                    </div>
                    <ol class="recipe-page__steps-list">
                        {% for step in recipe.recipetranslations[0].recipesteps %}
                            <li class="recipe-page__step page-card">
                                <span class="recipe-page__step-num">{{ loop.index }}</span>
                                <div class="recipe-page__step-body">
                                    <h3 class="recipe-page__step-title">{{ step.name }}</h3>
                                    {% if step.question %}
                                        <p class="recipe-page__step-question">{{ step.question|nl2br }}</p>
                                    {% endif %}
                                    {% if step.answer %}
                                        <div class="recipe-page__step-answer">{{ step.answer|nl2br }}</div>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ol>
                </section>
            {% endif %}
        </div>
    </article>
</div>
{% endblock %}

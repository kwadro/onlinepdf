{% extends "base.html.twig" %}
{% block title %}{{ recipe.recipetranslations[0].name }}{% endblock %}
{% block main %}
    {% include "recipe/breadcrumbs.html.twig" with {
        breadCrumbs: breadcrumbs
    } %}
    <div class="container my-4">
        <div class="row g-4">
            <!-- Image -->
            <div class="col-12 col-md-4 col-lg-3 text-center">
                {% if recipe.image %}
                    <img src="/uploads/recipes/{{ recipe.image }}"
                         class="img-fluid rounded shadow-sm mb-3"
                         alt="{{ recipe.recipetranslations[0].name }}">
                {% endif %}
            </div>

            <!-- Content -->
            <div class="col-12 col-md-8 col-lg-9">
                <h1 class="mb-3">{{ recipe.recipetranslations[0].name }}</h1>

                <p class="text-muted mb-4">
                    {{ recipe.recipetranslations[0].description }}
                </p>

                <h3 class="fw-bold mb-3">
                    {{ 'Ingredients'|trans }}
                </h3>

                    <ul class=" ingredients-grid ">
                        {% for component in recipe.recipetranslations[0].components %}
                            <li class="list-group-item  d-flex justify-content-between align-items-center">
                                <span>{{ component.name|split('|')[1] }}</span>
                                <span class="fw-bold">
                                   {{ component.quantity }} {{ component.unit }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
            </div>
        </div>

        <!-- Preparation steps -->
        <h3 class="text-center fw-bold my-4">
            {{ 'Preparation steps'|trans }}
        </h3>

        <ul class="list-group mb-4">
            {% for step in recipe.recipetranslations[0].recipesteps %}
                <li class="list-group-item">
                    <div class="d-flex flex-column flex-md-row gap-3">
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">
                                {{ step.name }}
                            </h5>

                            {% if step.question %}
                                <p class="mb-1 text-muted">
                                    {{ step.question }}
                                </p>
                            {% endif %}

                            {% if step.answer %}
                                <p class="mb-0">
                                    {{ step.answer }}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>

{% endblock %}

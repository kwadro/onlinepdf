{% extends 'base.html.twig' %}

{% block title %}{{ 'Login'|trans }}{% endblock %}

{% block main %}
<div class="page-content page-content--auth">
    <section class="page-hero page-hero--auth">
        <div class="page-hero__icon" aria-hidden="true">
            <i class="bi bi-box-arrow-in-right"></i>
        </div>
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ 'Login'|trans }}</h1>
            <p class="page-hero__subtitle">{{ 'auth.login_intro'|trans }}</p>
        </div>
    </section>

    <div class="page-card page-card--form auth-card">
        {% if error %}
            <div class="alert alert-danger page-alert" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="auth-session">
                <div class="auth-session__icon" aria-hidden="true">
                    <i class="bi bi-person-check"></i>
                </div>
                <p class="auth-session__text mb-0">
                    {{ 'auth.logged_in_as'|trans({'%email%': app.user.userIdentifier}) }}
                </p>
                <a href="{{ path('app_logout') }}" class="btn btn-outline-primary auth-session__logout">
                    {{ 'Logout'|trans }}
                </a>
            </div>
        {% else %}
            <form method="post" class="page-form auth-form">
                <div class="auth-form__field">
                    <label class="form-label page-form__label" for="username">{{ 'Email'|trans }}</label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="form-control page-form__control"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                <div class="auth-form__field">
                    <label class="form-label page-form__label" for="password">{{ 'Password'|trans }}</label>
                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="form-control page-form__control"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <div class="auth-form__remember">
                    <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                    <label for="_remember_me" class="form-check-label">{{ 'Remember me'|trans }}</label>
                </div>

                <div class="page-form__actions auth-form__actions">
                    <button class="btn btn-primary page-form__submit auth-form__submit" type="submit">
                        <i class="bi bi-box-arrow-in-right me-2"></i>{{ 'Sign in'|trans }}
                    </button>
                </div>
            </form>

            {% include 'security/_auth-divider.html.twig' with { label: 'OR' } %}
            {% include 'security/_auth-social.html.twig' with { mode: 'login' } %}

            <div class="auth-switch">
                <p class="auth-switch__text mb-0">{{ "If you haven't an account?"|trans }}</p>
                <a href="{{ path('app_register') }}" class="btn btn-outline-primary auth-switch__link">
                    {{ 'Registration'|trans }}
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

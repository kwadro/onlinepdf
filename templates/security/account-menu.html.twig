<ul class="dropdown-menu dropdown-menu-end p-1" aria-labelledby="dropdown-account">
    {% for item_menu in setting.menu %}
        {% if  item_menu.megamenutype =='AccountSidebar'%}
            <li  class="list-group-item p-1 {% if loop.first %}active fw-semibold{% endif %}">
                {{ item_menu.content|raw }}
                <a class="text-dark-custom text-decoration-none dropdown-item {% if item_menu.url in app.request.get('_route') %} active {% endif %}"
                   href="{{ absolute_url(path(item_menu.url, {_locale: app.request.locale})) }}">
                    {{ item_menu.name }}
                </a>
            </li>
        {% endif %}
    {% endfor %}
</ul>

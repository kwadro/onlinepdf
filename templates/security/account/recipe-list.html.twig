<div class="width-search container-fluid">
    {% set countRepeatVal = countRepeat|default('4') %}
    {% if recipes is not empty %}
        {% for i in 1..countRepeatVal %}
            {% for recipe in recipes %}
                <div class="row border border-1 border-success d-flex justify-content-start align-items-center">
                    <div class="col-xl-1 col-lg-1 col-md-1 col-sm-1 product-card-list shadow-sm">
                        <div class="position-relative">
                            {% if recipe.image %}
                                {% set recipeimage = '/uploads/recipes/' ~ recipe.image %}
                            {% else %}
                                {% set recipeimage = 'https://placehold.in/200' %}
                            {% endif %}
                            <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}">
                                <img src="{{ recipeimage }}" class="product-list-image w-100" alt="{{ recipe.recipetranslations[0].name }}"/>
                            </a>
                        </div>
                    </div>
                    <div class="col-3">
                        {% if recipes is not empty %}
                            {% for category in recipe.recipecategorys %}
                                <span class="category-badge mb-2 d-inline-block">{{ category.name }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="col-2">
                        <h6 class="recipe-name mb-1">{{ recipe.recipetranslations[0].name }}</h6>
                        <div class="recipe-info my-2 d-flex justify-content-start gap-2 align-items-center">
                            <span data-bs-toggle="tooltip" title="{{ 'Prepare time'|trans }}">
                                <i class="me-1 bi bi-clock"></i>{{ recipe.prepTimeMin }} {{ 'minutes'|trans }}
                            </span>
                            <span data-bs-toggle="tooltip" title="{{ 'Cook time'|trans }}">
                                <i class="me-1 bi bi-fire"></i>{{ recipe.cookTimeMin }} {{ 'minutes'|trans }}
                            </span>
                            <span data-bs-toggle="tooltip" title="{{ 'Servings'|trans }}">
                                <i class="me-1 bi bi-people"></i>{{ recipe.servings }}
                            </span>
                        </div>
                    </div>


                    <div class="col-23">
                        <a href="{{ path('recipe_edit', {id: recipe.id}) }}" class="btn btn-sm btn-primary w-100">
                            {{ 'View'|trans }}
                        </a>
                    </div>
                    <div class="col-2">
                        <a href="{{ path('recipe_edit', {id: recipe.id}) }}" class="btn btn-sm btn-primary w-100">
                            {{ 'Publish'|trans }}
                        </a>
                    </div>
                    <div class="col-2">
                        <a href="{{ path('recipe_edit', {id: recipe.id}) }}" class="btn btn-sm btn-primary w-100">
                            {{ recipe.status|trans }}
                        </a>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    {% else %}
        <h5 class="text-center">{{ 'We not found any recipe in this category'|trans }}</h5>
    {% endif %}
</div>

<div class="account-recipe-list">
    {% set countRepeatVal = countRepeat|default('1') %}
    {% if recipes is not empty %}
        {% for i in 1..countRepeatVal %}
            {% for recipe in recipes %}
                {% set publishValTitle = (recipe.recipetranslations[0].publish == 'Yes') ? 'Publish' : 'Private' %}
                {% set confirmValTitle = (recipe.recipetranslations[0].confirmation == 'Yes')
                    ? ((publishValTitle == 'Private') ? '' : 'Confirm')
                    : ((publishValTitle == 'Private') ? '' : 'Pending Confirmation')
                %}
                {% set publishVal = (recipe.recipetranslations[0].publish == 'Yes')
                    ? ((confirmValTitle == 'Confirm') ? '<i class="bi bi-check-circle"></i>' : '<i class="bi bi-check-circle"></i>')
                    : '<i class="bi bi-lock"></i>'
                %}
                {% set publishStatusClass = (recipe.recipetranslations[0].publish == 'Yes')
                    ? ((confirmValTitle == 'Confirm') ? 'is-published' : 'is-pending')
                    : 'is-private'
                %}
                {% set publishButtonLabel = (recipe.recipetranslations[0].publish == 'Yes') ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-send"></i>' %}
                {% set publishButtonLabelTitle = (recipe.recipetranslations[0].publish == 'Yes') ? 'UnPublish' : 'Publish' %}

                <article class="account-recipe-card page-card">
                    <div class="account-recipe-card__media">
                        {% if recipe.image %}
                            {% set recipeimage = '/uploads/recipes/' ~ recipe.image %}
                        {% else %}
                            {% set recipeimage = 'https://placehold.in/200' %}
                        {% endif %}
                        <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}">
                            <img
                                src="{{ recipeimage }}"
                                class="account-recipe-card__image"
                                alt="{{ recipe.recipetranslations[0].name }}"
                            >
                        </a>
                    </div>

                    <div class="account-recipe-card__body">
                        <div class="account-recipe-card__top">
                            {% for category in recipe.recipecategorys %}
                                <span class="category-badge account-recipe-card__category">{{ category.name }}</span>
                            {% endfor %}
                        </div>

                        <h3 class="account-recipe-card__title">
                            <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}">
                                {{ recipe.recipetranslations[0].name }}
                            </a>
                        </h3>

                        <div class="recipe-info account-recipe-card__meta">
                            <span data-bs-toggle="tooltip" title="{{ 'Prepare time'|trans }}">
                                <i class="bi bi-clock"></i>{{ recipe.prepTimeMin }} {{ 'minutes'|trans }}
                            </span>
                            <span data-bs-toggle="tooltip" title="{{ 'Cook time'|trans }}">
                                <i class="bi bi-fire"></i>{{ recipe.cookTimeMin }} {{ 'minutes'|trans }}
                            </span>
                            <span data-bs-toggle="tooltip" title="{{ 'Servings'|trans }}">
                                <i class="bi bi-people"></i>{{ recipe.servings }}
                            </span>
                        </div>

                        <div class="account-recipe-card__status">
                            <span class="account-recipe-card__status-badge {{ publishStatusClass }}" title="{{ publishValTitle|trans }}">
                                {{ publishVal|raw }}
                                {{ publishValTitle|trans }}
                            </span>
                            {% if confirmValTitle %}
                                <span class="account-recipe-card__status-text">{{ confirmValTitle|trans }}</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="account-recipe-card__actions">
                        {% if (recipe.recipetranslations[0].confirmation == 'No') or is_granted('ROLE_SUPER_ADMIN') %}
                            <div
                                class="account-recipe-card__action recipe-link"
                                data-action="click->scroll#openLink"
                                data-url="{{ path('recipe_edit', {id: recipe.id}) }}"
                            >
                                <span title="{{ 'Edit Recipe'|trans }}" class="btn btn-sm btn-primary account-recipe-card__btn">
                                    <i class="bi bi-pencil"></i>
                                </span>
                            </div>
                        {% endif %}

                        <div
                            class="account-recipe-card__action recipe-link"
                            data-action="click->scroll#openLink"
                            data-url="{{ path('publish_recipe', {id: recipe.id}) }}"
                        >
                            <span title="{{ publishButtonLabelTitle|trans }}" class="btn btn-sm btn-primary account-recipe-card__btn">
                                {{ publishButtonLabel|raw }}
                            </span>
                        </div>
                    </div>
                </article>
            {% endfor %}
        {% endfor %}
    {% else %}
        <div class="page-empty">
            <h5 class="page-empty__title">{{ 'We not found any recipe in this category'|trans }}</h5>
        </div>
    {% endif %}
</div>

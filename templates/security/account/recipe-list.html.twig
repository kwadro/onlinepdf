<div class="width-search container-fluid mb-3">
    {% set countRepeatVal = countRepeat|default('4') %}
    {% if recipes is not empty %}
        {% for i in 1..countRepeatVal %}
            {% for recipe in recipes %}
                {% set publishVal = (recipe.recipetranslations[0].publish === 'Yes') ? '<i class="bi bi-check-circle text-success"></i>' :'<i class="bi bi-lock"></i>'  %}
                {% set publishValTitle = (recipe.recipetranslations[0].publish === 'Yes') ? 'Publish' :'Private'  %}
                {% set confirmValTitle = (recipe.recipetranslations[0].confirmation === 'Yes') ? ((publishValTitle==='Private') ? '' : 'Confirm') : ((publishValTitle==='Private') ? '' : 'Pending Confirmation')  %}
                {% set publishButtonLabel = (recipe.recipetranslations[0].publish==='Yes') ? '<i class="bi bi-eye-slash"></i>' :'<i class="bi bi-send"></i>'  %}
                {% set publishButtonLabelTitle = (recipe.recipetranslations[0].publish==='Yes') ? 'UnPublish' :'Publish'  %}
                {% set recipeSlug = recipe.recipetranslations[0].slug %}
                <div class="row mb-2 rounded-3 p-2 border border-1 border-success d-flex justify-content-start align-items-center">
                    <div class="col-xl-1 col-lg-1 col-md-1 col-sm-1 product-card-list shadow-sm">
                        <div class="position-relative">
                            {% if recipe.image %}
                                {% set recipeimage = '/uploads/recipes/' ~ recipe.image %}
                            {% else %}
                                {% set recipeimage = 'https://placehold.in/200' %}
                            {% endif %}
                            <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}">
                                <img src="{{ recipeimage }}" class="product-list-image w-100" alt="{{ recipe.recipetranslations[0].name }}"/>
                            </a>
                        </div>
                    </div>
                    <div class="col-2">
                        {% if recipes is not empty %}
                            {% for category in recipe.recipecategorys %}
                                <span class="category-badge mb-2 d-inline-block">{{ category.name }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="col-2">
                        <h6 class="recipe-name mb-1">{{ recipe.recipetranslations[0].name }}</h6>
                    </div>
                    <div class="col-2">
                        <div class="recipe-info my-2 d-flex justify-content-start gap-2 align-items-center">
                            <span data-bs-toggle="tooltip" title="{{ 'Prepare time'|trans }}">
                                <i class="me-1 bi bi-clock"></i>{{ recipe.prepTimeMin }} {{ 'minutes'|trans }}
                            </span>
                            <span data-bs-toggle="tooltip" title="{{ 'Cook time'|trans }}">
                                <i class="me-1 bi bi-fire"></i>{{ recipe.cookTimeMin }} {{ 'minutes'|trans }}
                            </span>
                            <span data-bs-toggle="tooltip" title="{{ 'Servings'|trans }}">
                                <i class="me-1 bi bi-people"></i>{{ recipe.servings }}
                            </span>
                        </div>
                    </div>

                    <div class="col-1 recipe-link"
                         data-action="click->scroll#openLink"
                         data-url="{{ path('recipe_edit', {id: recipe.id}) }}"
                    >
                        <span title="{{ 'Edit Recipe'|trans }}"  class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center" >
                            <i class="bi bi-pencil"></i>
                        </span>
                    </div>
                    <div class="col-1 recipe-link"
                         data-action="click->scroll#openLink"
                         data-url="{{ path('publish_recipe', {id: recipe.id}) }}"
                    >
                        <span   title="{{ publishButtonLabelTitle|trans }}"  class="btn btn-sm btn-primary w-100  d-flex align-items-center justify-content-center">
                            {{ publishButtonLabel|raw }}
                        </span>
                    </div>
                    <div class="col-1 recipe-link"
                         data-action="click->scroll#openLink"
                         data-url="{{ path('catalog_show', {urlKey: recipeSlug}) }}"
                    >
                        <span data-target="_blank" title="{{'View'|trans }}"  class="btn btn-sm btn-primary w-100" style="font-size: 14px;">
                            <i class="bi bi-eye"></i>
                        </span>
                    </div>

                    <div title="{{ publishValTitle|trans }}" class="col-1">
                            {{ publishVal|raw }}
                    </div>
                    <div  class="col-1"   style="font-size: 12px; font-weight: 600;">
                            {{ confirmValTitle|trans }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    {% else %}
        <h5 class="text-center">{{ 'We not found any recipe in this category'|trans }}</h5>
    {% endif %}
</div>

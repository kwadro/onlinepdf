
<turbo-frame class="{{ frameClass }}" id="{{ typeData }}_recipe_{{ recipe.id }}">
        <input type="hidden" name="_method" value="patch" autocomplete="off">
        <input type="hidden" name="authenticity_token"
               value="{{ token }}"
               autocomplete="off"
        >

        <div class="position-relative d-grid" style="grid-template-rows: 1fr auto;">
            <div id="container-recipe-{{ typeData }}" class="position-relative">
                                <textarea id="recipe-{{ typeData }}"
                                          name="{{ typeData }}"
                                          data-fieldname="{{ typeData }}"
                                          data-textareaedit-target="textarea"
                                          data-action="input->textareaedit#autoResize focus->textareaedit#onTextareaFocus blur->textareaedit#onTextareaBlur"
                                          class="field-edit {{ textClass }}  d-block position-absolute w-100 border-0 shadow-none"
                                          placeholder="{{ placeholder }}"
                                >{{valueField}}</textarea>
                <div class="d-flex justify-content-end gap-2 mt-55 pe-1 h-4"
                     data-textareaedit-target="count{{ typeData}}"
                >
                    <div class="count-warning  text-recipe-12 d-none" role="alert"
                         data-textareaedit-target="countWarning{{ typeData }}">
                    </div>
                    <div class="text-recipe-gray-500 text-recipe-12 d-none"
                         data-textareaedit-target="countSpan{{ typeData  }}">
                    </div>
                </div>
            </div>

        </div>
    </form>
</turbo-frame>

{% set setting = site_settings() %}
{% extends "base.html.twig" %}
{% block main %}
    {{ form_start(form) }}
    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            💾 Save order
        </button>
    </div>

    <div class="recipe-edit-page row">
        {{ form_row(form.id) }}
        <div class="row">
            <div class="col-3 mb-3">
                IMAGE WILL HERE
            </div>
            <div class="col-9 mb-3">
                {{ form_row(form.recipetranslations[0].name) }}
                {{ form_row(form.recipetranslations[0].short_description) }}
                {{ form_row(form.recipetranslations[0].description) }}

            </div>
        </div>
        <div class="row mt-3 mb-3">
            <div class="col-12">
                {{ form_row(form.recipetranslations[0].notes,{'attr': {'class': 'mb-1 form-control notes'}}) }}
            </div>
        </div>
        <div class="row">
            <div class="col-3 mb-3">
                <h4 class="fw-bold ms-2 my-3">{{'Time'|trans}}</h4>
                {{ form_row(form.prep_time_min) }}
                {{ form_row(form.cook_time_min) }}
                {{ form_row(form.servings) }}
                <h4 class="fw-bold ms-2 my-3">{{'Ingredients'|trans}}</h4>
                {{ form_row(form.recipetranslations[0].components,{'attr': {'class': 'mt-3 mb-1 form-control components'}}) }}
            </div>
            <div class="col-9 mb-3" data-controller="sortable">
                <h4 class="fw-bold ms-2 my-3">{{'Steps'|trans}}</h4>
                <div id="recipe-steps" class="recipesteps"
                     data-sortable-target="container"
                     data-prototype="{{ form_widget(form.recipetranslations[0].recipesteps.vars.prototype)|e('html_attr') }}">

                    {% for stepForm in form.recipetranslations[0].recipesteps %}
                        <div class="container-recipe-step-item">
                            {{ form_widget(stepForm) }}
                            <button type="button" class="remove-step"
                                    data-action="click->sortable#remove">X</button>
                        </div>
                    {% endfor %}
                </div>
                <button type="button" id="add-step" class="add-step" data-action="click->sortable#add">➕ Add</button>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}


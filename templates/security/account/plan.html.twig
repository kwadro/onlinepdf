{% extends "base-account.html.twig" %}

{% block main %}
<div class="page-content page-content--plan account-plan-page">
    <section class="page-hero page-hero--account">
        <div class="page-hero__icon" aria-hidden="true">
            <i class="bi bi-star"></i>
        </div>
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ 'subscription.your_plan'|trans }}</h1>
            {% if activeSubscription and activeSubscription.plan %}
                <div class="page-account__meta">
                    <span class="page-author__count">{{ activeSubscription.plan.name }}</span>
                    <span class="account-plan-hero__status account-plan-hero__status--active">
                        {{ 'subscription.status_active'|trans }}
                    </span>
                </div>
            {% else %}
                <p class="page-hero__subtitle">{{ 'subscription.no_active_plan'|trans }}</p>
            {% endif %}
        </div>
    </section>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show page-alert" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <section class="home-section">
        <div class="home-section__head">
            <h2 class="home-section__title">{{ 'subscription.current_plan'|trans }}</h2>
        </div>
        <div class="home-section__body">
            <div class="page-card account-plan-current">
                {% if activeSubscription %}
                    {% set plan = activeSubscription.plan %}
                    <dl class="account-plan-details">
                        <div class="account-plan-details__item">
                            <dt>{{ 'subscription.plan_name'|trans }}</dt>
                            <dd>{{ plan ? plan.name : '-' }}</dd>
                        </div>
                        <div class="account-plan-details__item">
                            <dt>{{ 'subscription.status'|trans }}</dt>
                            <dd>
                                <span class="account-plan-badge account-plan-badge--active">
                                    {{ 'subscription.status_active'|trans }}
                                </span>
                            </dd>
                        </div>
                        <div class="account-plan-details__item">
                            <dt>{{ 'subscription.expires_at'|trans }}</dt>
                            <dd>
                                {% if activeSubscription.expiresAt %}
                                    {{ activeSubscription.expiresAt|date('d.m.Y H:i') }}
                                {% else %}
                                    {{ 'subscription.unlimited'|trans }}
                                {% endif %}
                            </dd>
                        </div>
                    </dl>

                    {% if plan and plan.features is not empty %}
                        <div class="account-plan-features">
                            <h3 class="account-plan-features__title">{{ 'subscription.features'|trans }}</h3>
                            <ul class="account-plan-features__list">
                                {% for feature in plan.features %}
                                    <li>{{ feature }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {% if plan and plan.code != 'free' and not pendingSubscription %}
                        <form method="post" action="{{ path('account_plan_cancel', {_locale: app.request.locale}) }}" class="account-plan-current__actions" data-turbo="false">
                            <input type="hidden" name="_token" value="{{ csrf_token('account_plan_cancel') }}">
                            <button type="submit" class="btn btn-outline-danger account-plan-btn account-plan-btn--danger">
                                <i class="bi bi-x-circle me-2"></i>{{ 'subscription.cancel_plan'|trans }}
                            </button>
                        </form>
                    {% endif %}
                {% else %}
                    <div class="page-empty account-plan-empty">
                        <div class="page-empty__icon" aria-hidden="true">
                            <i class="bi bi-star"></i>
                        </div>
                        <p class="page-empty__text mb-0">{{ 'subscription.no_active_plan'|trans }}</p>
                    </div>
                {% endif %}

                {% if pendingSubscription %}
                    <div class="account-plan-pending">
                        <div class="account-plan-pending__icon" aria-hidden="true">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div class="account-plan-pending__copy">
                            <p class="account-plan-pending__title">
                                {{ 'subscription.pending_payment'|trans({
                                    '%plan%': pendingSubscription.plan ? pendingSubscription.plan.name : ''
                                }) }}
                            </p>
                            <p class="account-plan-pending__text">{{ 'subscription.pending_keeps_current_plan'|trans }}</p>
                        </div>
                        <div class="account-plan-pending__actions">
                            <a
                                href="{{ path('account_plan_checkout', {_locale: app.request.locale, id: pendingSubscription.id}) }}"
                                class="btn btn-primary account-plan-btn"
                                data-turbo="false"
                            >
                                <i class="bi bi-credit-card me-2"></i>{{ 'subscription.continue_payment'|trans }}
                            </a>
                            <form method="post" action="{{ path('account_plan_pending_cancel', {_locale: app.request.locale}) }}" data-turbo="false">
                                <input type="hidden" name="_token" value="{{ csrf_token('account_plan_pending_cancel') }}">
                                <button type="submit" class="btn btn-outline-secondary account-plan-btn">
                                    {{ 'subscription.cancel_pending'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section__head">
            <h2 class="home-section__title">{{ 'subscription.choose_plan'|trans }}</h2>
        </div>
        <div class="home-section__body">
            <div class="page-card account-plan-choose">
                {% if showPlanForm %}
                    <p class="account-plan-choose__intro">
                        {% if activeSubscription %}
                            {{ 'subscription.upgrade_help'|trans }}
                        {% else %}
                            {{ 'subscription.choose_plan_help'|trans }}
                        {% endif %}
                    </p>

                    <form
                        method="post"
                        action="{{ path('account_plan_subscribe', {_locale: app.request.locale}) }}"
                        id="subscription-form"
                        class="account-plan-form"
                        data-turbo="false"
                    >
                        <input type="hidden" name="_token" value="{{ csrf_token('account_plan_subscribe') }}">

                        <div class="account-plan-options">
                            {% for plan in selectablePlans %}
                                <label class="account-plan-option" for="plan-{{ plan.code }}">
                                    <input
                                        class="account-plan-option__input"
                                        type="radio"
                                        name="plan"
                                        id="plan-{{ plan.code }}"
                                        value="{{ plan.code }}"
                                        data-price="{{ plan.price }}"
                                        {% if loop.first %}checked{% endif %}
                                        required
                                    >
                                    <span class="account-plan-option__card">
                                        <span class="account-plan-option__head">
                                            <span class="account-plan-option__name">{{ plan.name }}</span>
                                            <span class="account-plan-option__price">
                                                {% if plan.price == 0 %}
                                                    {{ 'subscription.free'|trans }}
                                                {% else %}
                                                    {{ (plan.price / 100)|number_format(2, '.', ' ') }} {{ plan.currency }}
                                                {% endif %}
                                            </span>
                                        </span>
                                        <span class="account-plan-option__interval">{{ plan.interval.value }}</span>
                                        {% if plan.features is not empty %}
                                            <ul class="account-plan-option__features">
                                                {% for feature in plan.features %}
                                                    <li>{{ feature }}</li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                    </span>
                                </label>
                            {% endfor %}
                        </div>

                        <div id="payment-methods-block" class="account-plan-payment">
                            <h3 class="account-plan-payment__title">{{ 'subscription.payment_method'|trans }}</h3>
                            <div class="account-plan-payment__options">
                                {% for method in paymentMethods %}
                                    <label class="account-plan-payment-option">
                                        <input
                                            type="radio"
                                            name="payment_method"
                                            value="{{ method.code }}"
                                            class="account-plan-payment-option__input"
                                            {% if loop.first %}checked{% endif %}
                                            required
                                        >
                                        <span class="account-plan-payment-option__label">
                                            <i class="bi bi-wallet2 me-2"></i>{{ method.name }}
                                        </span>
                                    </label>
                                {% else %}
                                    <p class="account-plan-payment__empty">{{ 'subscription.no_payment_methods'|trans }}</p>
                                {% endfor %}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary account-plan-btn account-plan-btn--submit" id="subscribe-button">
                            <i class="bi bi-arrow-right-circle me-2"></i>{{ 'subscription.subscribe_button'|trans }}
                        </button>
                    </form>
                {% elseif pendingSubscription %}
                    <p class="account-plan-choose__intro">{{ 'subscription.complete_pending_payment'|trans }}</p>
                    <a
                        href="{{ path('account_plan_checkout', {_locale: app.request.locale, id: pendingSubscription.id}) }}"
                        class="btn btn-primary account-plan-btn"
                        data-turbo="false"
                    >
                        <i class="bi bi-credit-card me-2"></i>{{ 'subscription.continue_payment'|trans }}
                    </a>
                {% elseif activeSubscription and selectablePlans is empty %}
                    <div class="page-empty account-plan-empty">
                        <div class="page-empty__icon" aria-hidden="true">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <p class="page-empty__text mb-0">{{ 'subscription.already_on_highest_plan'|trans }}</p>
                    </div>
                {% else %}
                    <div class="page-empty account-plan-empty">
                        <div class="page-empty__icon" aria-hidden="true">
                            <i class="bi bi-info-circle"></i>
                        </div>
                        <p class="page-empty__text mb-0">{{ 'subscription.no_plans_available'|trans }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
</div>
{% endblock %}

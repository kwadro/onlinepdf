{% set setting = site_settings() %}
{% extends "base.html.twig" %}
{% block main %}
    <div class="width-search d-flex justify-content-between align-items-center">
        <button class="my-3 btn btn-sm btn-primary text-center">
            {{ 'Add new recipe'|trans }}
        </button>
    </div>
    {{ dump(recipes) }}
    {% if recipes is not empty %}
        <div class="width-search d-flex justify-content-between align-items-center">
            <h4 class="fw-bold ms-2 my-3">{{'Recently viewed'|trans}}</h4>
        </div>
        {% include "homepage/recipe-grid.html.twig" with {
            'recipes': recipes,
            'countRepeat': 1
        } %}
    {% else %}
        <h5 class="text-center">{{ "You haven’t viewed any recipes yet."|trans }}</h5>
    {% endif %}
{% endblock %}

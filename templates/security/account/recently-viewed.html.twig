{% extends "base.html.twig" %}
{% block main %}
<div class="page-content page-content--recent">
    <section class="page-hero page-hero--account">
        <div class="page-hero__icon" aria-hidden="true">
            <i class="bi bi-clock-history"></i>
        </div>
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ 'Recently viewed'|trans }}</h1>
            <div class="page-account__meta">
                <span class="page-author__count">
                    {{ recipes|length }}
                    {{ recipes|length == 1 ? 'page.search_result_one'|trans : 'page.search_result_many'|trans }}
                </span>
            </div>
        </div>
    </section>

    {% if recipes is not empty %}
        <section class="home-section">
            <div class="home-section__head">
                <h2 class="home-section__title">{{ 'page.recently_viewed_list'|trans }}</h2>
            </div>
            <div class="home-section__body">
                {% include "homepage/recipe-grid.html.twig" with {
                    recipes: recipes,
                    favoriteIds: favoriteIds|default([]),
                    countRepeat: 1,
                } %}
            </div>
        </section>
    {% else %}
        <div class="page-empty">
            <div class="page-empty__icon" aria-hidden="true">
                <i class="bi bi-clock"></i>
            </div>
            <h3 class="page-empty__title">{{ 'page.recently_empty_title'|trans }}</h3>
            <p class="page-empty__text">{{ 'page.recently_empty_hint'|trans }}</p>
            <a href="{{ path('homepage') }}" class="btn btn-primary page-form__submit">
                <i class="bi bi-search me-2"></i>{{ 'Find a recipe'|trans }}
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% set setting = site_settings() %}
{% set recipeTranslation = recipe.recipetranslations[0] %}
{% set recipeName = recipeTranslation.name|default('page.facebook_recipe_subtitle'|trans) %}
{% set currentTemplate = form.template.vars.value|default(1) %}

{% extends 'base-account.html.twig' %}

{% block title %}{{ 'page.facebook_recipe_title'|trans }} — {{ recipeName }}{% endblock %}

{% block main %}
<div
    class="page-content page-content--facebook-recipe recipe-facebook-page"
    data-controller="facebook-recipe"
    data-facebook-recipe-autosave-url-value="{{ path('recipe_autosave', {_locale: app.request.locale}) }}"
    data-facebook-recipe-locale-value="{{ app.request.locale }}"
    data-facebook-recipe-site-value="{{ app.request.attributes.get('site').id }}"
>
    {{ form_start(form, {
        attr: {
            class: 'recipe-facebook-form',
            'data-turbo': 'false',
        },
    }) }}
        {{ form_row(form.id) }}
        {{ form_row(form.recipe_id) }}
        {{ form_widget(form._token) }}

        {% set saveButton = form_row(form.save, {
            attr: {
                class: 'btn btn-success recipe-editor-btn recipe-editor-btn--save',
                'data-action': 'click->scroll#saveScroll',
            },
        }) %}

        <section class="page-hero page-hero--account recipe-facebook-page__hero">
            <div class="page-hero__icon" aria-hidden="true">
                <i class="bi bi-facebook"></i>
            </div>
            <div class="page-hero__copy">
                <h1 class="page-hero__title">{{ 'page.facebook_recipe_title'|trans }}</h1>
                <p class="page-hero__subtitle">{{ recipeName }}</p>
            </div>
        </section>

        <div class="recipe-editor-toolbar page-card recipe-facebook-page__toolbar">
            <div class="recipe-editor-toolbar__primary">
                {{ saveButton|raw }}
                {{ form_row(form.save_close, { attr: { class: 'btn btn-warning recipe-editor-btn' } }) }}
                {{ form_row(form.close, { attr: { class: 'btn btn-secondary recipe-editor-btn' } }) }}
            </div>
            <div class="recipe-editor-toolbar__secondary">
                <a
                    href="{{ path('recipe_edit', { id: recipe.id, _locale: app.request.locale }) }}"
                    class="btn btn-outline-primary recipe-editor-btn recipe-editor-btn--view"
                >
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    {{ 'page.facebook_back_to_recipe'|trans }}
                </a>
            </div>
        </div>

        <div class="page-card recipe-facebook-page__tabs-wrap">
            <div class="recipe-facebook-tabs" role="tablist" aria-label="{{ 'page.facebook_recipe_tabs'|trans }}">
                <button
                    type="button"
                    class="recipe-facebook-tabs__btn is-active"
                    role="tab"
                    id="facebook-tab-image"
                    aria-selected="true"
                    aria-controls="facebook-panel-image"
                    data-facebook-recipe-target="imageTab"
                    data-action="facebook-recipe#showImage"
                >
                    <i class="bi bi-image" aria-hidden="true"></i>
                    {{ 'Image'|trans }}
                </button>
                <button
                    type="button"
                    class="recipe-facebook-tabs__btn"
                    role="tab"
                    id="facebook-tab-text"
                    aria-selected="false"
                    aria-controls="facebook-panel-text"
                    data-facebook-recipe-target="textTab"
                    data-action="facebook-recipe#showText"
                >
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    {{ 'Text'|trans }}
                </button>
            </div>
        </div>

        <div
            id="facebook-panel-image"
            class="recipe-facebook-panel"
            role="tabpanel"
            aria-labelledby="facebook-tab-image"
            data-facebook-recipe-target="imagePanel"
        >
            <div class="row g-3">
                <div class="col-12">
                    <section class="page-card recipe-facebook-page__design">
                        <div class="home-section__head">
                            <h2 class="home-section__title">{{ 'page.facebook_design_title'|trans }}</h2>
                        </div>
                        <div class="recipe-facebook-design-grid">
                            <button
                                type="button"
                                class="recipe-facebook-design-card {{ currentTemplate == 1 ? 'is-active' : '' }}"
                                data-template="1"
                                data-facebook-recipe-target="designOption"
                                data-action="facebook-recipe#selectDesign"
                            >
                                <span class="recipe-facebook-design-card__preview recipe-facebook-design-card__preview--classic" aria-hidden="true">
                                    <span class="recipe-facebook-design-card__preview-text"></span>
                                    <span class="recipe-facebook-design-card__preview-image"></span>
                                </span>
                                <span class="recipe-facebook-design-card__label">{{ 'page.facebook_design_classic'|trans }}</span>
                                <span class="recipe-facebook-design-card__hint">{{ 'page.facebook_design_classic_hint'|trans }}</span>
                            </button>
                            <button
                                type="button"
                                class="recipe-facebook-design-card {{ currentTemplate == 2 ? 'is-active' : '' }}"
                                data-template="2"
                                data-facebook-recipe-target="designOption"
                                data-action="facebook-recipe#selectDesign"
                            >
                                <span class="recipe-facebook-design-card__preview recipe-facebook-design-card__preview--modern" aria-hidden="true">
                                    <span class="recipe-facebook-design-card__preview-image"></span>
                                    <span class="recipe-facebook-design-card__preview-text"></span>
                                </span>
                                <span class="recipe-facebook-design-card__label">{{ 'page.facebook_design_modern'|trans }}</span>
                                <span class="recipe-facebook-design-card__hint">{{ 'page.facebook_design_modern_hint'|trans }}</span>
                            </button>
                        </div>
                        {{ form_widget(form.template) }}
                    </section>
                </div>
                <div class="col-12 col-xl-4">
                    <section class="page-card recipe-facebook-page__fields">
                        <div class="home-section__head">
                            <h2 class="home-section__title">{{ 'page.facebook_image_fields'|trans }}</h2>
                        </div>
                        <div class="recipe-facebook-page__field-list">
                            {{ form_row(form.title1) }}
                            {{ form_row(form.title2) }}
                            {{ form_row(form.title3) }}
                            {{ form_row(form.content1) }}
                            {{ form_row(form.content2) }}
                            {{ form_row(form.content3) }}
                            {{ form_row(form.notes, { attr: { class: 'form-control notes mb-1' } }) }}
                        </div>
                        <p class="recipe-facebook-page__hint">{{ 'page.facebook_image_hint'|trans }}</p>
                    </section>
                </div>
                <div class="col-12 col-xl-8">
                    <section class="page-card recipe-facebook-page__preview">
                        <div class="home-section__head">
                            <h2 class="home-section__title">{{ 'page.facebook_preview'|trans }}</h2>
                        </div>
                        {% if recipe.id and recipeTranslation.facebookImage %}
                            {% set recipeImage = '/facebook/' ~ recipeTranslation.facebookImage %}
                        {% else %}
                            {% set recipeImage = 'https://placehold.in/900x900/eeeeee/999999?text=Facebook+Preview' %}
                        {% endif %}
                        <div class="recipe-facebook-preview">
                            <img
                                id="recipe-facebook-image"
                                src="{{ recipeImage }}"
                                class="recipe-facebook-preview__image"
                                alt="{{ recipeName }}"
                                width="900"
                            >
                        </div>
                    </section>
                </div>
            </div>
        </div>

        <div
            id="facebook-panel-text"
            class="recipe-facebook-panel d-none"
            role="tabpanel"
            aria-labelledby="facebook-tab-text"
            data-facebook-recipe-target="textPanel"
        >
            <section class="page-card recipe-facebook-page__fields">
                <div class="home-section__head">
                    <h2 class="home-section__title">{{ 'page.facebook_text_fields'|trans }}</h2>
                </div>
                <div class="recipe-facebook-page__field-list recipe-facebook-page__field-list--text">
                    {{ form_row(form.text_post) }}
                    <div class="recipe-facebook-page__tag-field">
                        {{ form_row(form.tag) }}
                    </div>
                </div>
                <p class="recipe-facebook-page__hint">{{ 'page.facebook_text_hint'|trans }}</p>
            </section>
        </div>
    {{ form_end(form, { render_rest: false }) }}
</div>
{% endblock %}

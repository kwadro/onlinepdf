{% set setting = site_settings() %}
{% extends "base.html.twig" %}
{% block main %}
<form method="post" action="{{ absolute_url(path('action_recipe')) }}">
    <div class="width-search d-flex justify-content-end gap-3 align-items-center"
         data-controller="textareaedit">

        <button type="submit" name="action" value="delete"  class="my-3 btn btn btn-danger text-center">
            {{ 'Delete'|trans }}
        </button>
        <button type="submit" name="action" value="save" class="my-3 btn btn btn-secondary text-center">
            {{ 'Save'|trans }}
        </button>
        <button type="submit" name="action" value="save_close" class="my-3 btn btn btn-secondary text-center">
            {{ 'Save and Close'|trans }}
        </button>
        <button type="submit" name="action" value="publish" class="my-3 btn btn btn-primary text-center">
            {{ 'Publish'|trans }}
        </button>
    </div>
    <div class="width-search row mb-5">

        <div class="col-3">
            <div id="recipe_image" data-controller="image-cropper">
                <div data-image-cropper-target="existingImage">
                    <div class="bg-recipe-gray-200 p-2">
                        <div
                            class="position-relative  image-upload text-center d-flex align-items-center justify-content-center">
                            <div class="text-recipe-gray-600">
                                <img class="w-16 mx-auto pointer-events-none"
                                     src="{{ absolute_url(asset('images/camera.png')) }}"/>

                                <p class="text-recipe-body-16 font-semibold mt-md">Upload recipe photo</p>

                                <p class="text-recipe-12 px-rg">Show others your finished dish</p>
                            </div>

                            <input type="file"
                                   name="file"
                                   accept="image/gif, image/jpeg, image/png, image/bmp"
                                   aria-label="Upload recipe photo"
                                   data-image-cropper-target="fileInput"
                                   data-action="change->image-cropper#loadImage"
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-9" data-controller="textareaedit"
             data-textareaedit-max-length-title-value="100"
             data-textareaedit-max-length-desc-value="1500"
        >
            {% include "security/account/textarea.html.twig" with {
                'recipe': recipe,
                'typeData': 'title',
                'valueField': recipe.recipetranslations[0].name ,
                'token': 'user-token',
                'placeholder': 'Title: My best-ever pea soup.',
                'frameClass':'',
                'textClass':'text-lg'
            } %}
            <div class="d-flex flex-row justify-content-start align-items-center gap-2 mb-3">
                <div class="user-image" style="height: 40px;width: max-content">
                    <img id="user-image"
                         src="{{ '/uploads/avatars/' ~ user.avatarurl }}"
                         class="profile-image small"
                         alt="{{ user.firstname ~ ' ' ~ user.lastname }}"
                         data-editing-target="userImage"
                    />
                </div>
                <div class="user-info">
                    <span> {{ user.firstname ~ ' ' ~ user.lastname }} </span>
                    <span> @cook-{{ user.id }} </span>
                </div>
            </div>
            {% include "security/account/textarea.html.twig" with {
                'recipe': recipe,
                'typeData': 'short_description',
                'valueField': recipe.recipetranslations[0].shortDescription,
                'token': 'user-token',
                'placeholder': 'Share a general info about this dish.',
                'frameClass':'',
                'textClass':'text-sm'
            } %}
            {% include "security/account/textarea.html.twig" with {
                'recipe': recipe,
                'typeData': 'description',
                'valueField': recipe.recipetranslations[0].description,
                'token': 'user-token',
                'placeholder': 'Share a little more about this dish. What or who inspired you to cook it? What makes it special to you? What\'s your favourite way to eat it? Use @ to tag others.',
                'frameClass':'',
                'textClass':'text-sm'
            } %}
        </div>

        <div class="col-3"
             data-controller="textareaedit"
             data-textareaedit-max-length-serving-value="50"
             data-textareaedit-max-length-timeprepare-value="50"
             data-textareaedit-max-length-timecook-value="50"
        >
            <h4 class="fw-bold ms-2 my-3">{{'Ingredients'|trans}}</h4>
            <div class="d-flex gap-sm align-items-center justify-content-between">
                <label class="text-recipe-gray-600 pb-3">Serves</label>
                         {% include "security/account/textarea.html.twig" with {
                            'recipe': recipe,
                            'typeData': 'serving',
                            'token': 'user-token',
                            'valueField':recipe.servings,
                            'placeholder': '2-people',
                            'frameClass':'w-50',
                            'textClass':'text-sm'
                        } %}

            </div>
            <div class="d-flex gap-sm align-items-center justify-content-between">
                <label class="text-recipe-gray-600 pb-3">Time of prepare</label>
                {% include "security/account/textarea.html.twig" with {
                    'recipe': recipe,
                    'typeData': 'timeprepare',
                    'token': 'user-token',
                    'valueField':recipe.prepTimeMin,
                    'placeholder': '30' ,
                    'frameClass':'w-50',
                    'textClass':'text-sm'
                } %}

            </div>
            <div class="d-flex gap-sm align-items-center justify-content-between">
                <label class="text-recipe-gray-600 pb-3">Time of cook</label>
                {% include "security/account/textarea.html.twig" with {
                    'recipe': recipe,
                    'typeData': 'timecook',
                    'token': 'user-token',
                    'valueField':recipe.cookTimeMin,
                    'placeholder': '30',
                    'frameClass':'w-50',
                    'textClass':'text-sm'
                } %}

            </div>
        </div>
        <div class="col-9">
            <h4 class="fw-bold ms-2 my-3">{{'Steps'|trans}}</h4>

        </div>
    </div>
</form>
{% endblock %}

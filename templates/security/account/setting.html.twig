
{% set setting = site_settings() %}
{% extends "base.html.twig" %}
{% block main %}
    <div class="width-search d-flex justify-content-between align-items-center">
        <h4 class="fw-bold ms-2 my-3">{{'Profile'|trans}}</h4>
    </div>

    <div class="width-search setting-page row g-4" >
        <div class="col-4 d-flex flex-column justify-content-center align-items-center user-select-none" >

        {% set image_button = 'Add image'|trans %}
        {% set full_name = '' %}

        {% if recipeUser.avatarurl %}
            {% if 'http' in app.user.avatarUrl  %}
                {% set avatarimage = recipeUser.avatarurl %}
            {% else %}
                {% set avatarimage = '/uploads/avatars/' ~ recipeUser.avatarurl %}
            {% endif %}

            {% set image_button = 'Edit image'|trans %}
        {% else %}
            {% set avatarimage = 'https://placehold.in/200' %}
        {% endif %}

        {% set account_name = '@cook-1000' ~ recipeUser.id %}

        {% set user_button = 'Add name'|trans %}
        {% set user_class = '' %}
        {% if recipeUser is defined and recipeUser.firstname is defined and recipeUser.firstname %}
            {% set full_name = recipeUser.firstname ~ ' ' ~ recipeUser.lastname %}
            {% set user_button = 'Edit name'|trans %}
            {% set user_class = 'ms-3' %}
        {% endif %}

            <img id="user-image"
                src="{{ avatarimage }}"
                class="profile-image"

                alt="{{ full_name }}"
                data-editing-target="resourceImage"
            />

            <button
                id="button-open-image"
                class="my-3 btn btn-sm btn-primary text-center"
                data-ajaxurl="{{ ajaxUrl }}"
                data-formcode="avatar-image"
                data-entity="Avatar"
                data-action="click->popup#open click->editing#openImage"
            >
                {{ image_button }}
            </button>
    </div>
        <div class="col-4">
            <div class="col d-flex flex-row justify-content-start align-items-center">
                <div id="user-full-name"
                    class="editing-field"
                    data-editing-target="fullName"
                >
                {{ full_name }}
                </div>
                <button
                    id="button-open-name"
                    class="{{ user_class }} btn btn-sm btn-primary text-center"
                    data-ajaxurl="{{ ajaxUrl }}"
                    data-formcode="user-name"
                    data-baselabel="{{ user_button }}"
                    data-action="click->popup#open click->editing#openName"
                >
                    {{ user_button }}
                </button>
            </div>
            <div class="col my-3 d-flex flex-row justify-content-start align-items-center">
                {{ account_name }}
            </div>
        </div>

    </div>

    {% include "security/account/add-first-recipe.html.twig" %}
{% endblock %}

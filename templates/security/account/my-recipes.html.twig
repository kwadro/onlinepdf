
{% extends "base-account.html.twig" %}
{% block main %}
<div class="page-content page-content--my-recipes account-recipes-page">
    <section class="page-hero page-hero--account">
        <div class="page-hero__icon" aria-hidden="true">
            <i class="bi bi-journal-text"></i>
        </div>
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ 'Your recipes'|trans }}</h1>
            <div class="page-account__meta">
                <span class="page-author__count">
                    {{ recipes|length }}
                    {{ recipes|length == 1 ? 'page.search_result_one'|trans : 'page.search_result_many'|trans }}
                </span>
            </div>
        </div>
        <div class="page-account__actions">
            <button
                type="button"
                data-add-url="{{ path('add_recipe', {_locale: app.request.locale}) }}"
                data-action="click->scroll#addRecipe"
                class="btn btn-primary page-account__cta"
            >
                <i class="bi bi-plus-lg me-2"></i>{{ 'Add new recipe'|trans }}
            </button>
        </div>
    </section>

    {% if recipes is not empty %}
        <section class="home-section account-recipes-page__list">
            <div class="home-section__head">
                <h2 class="home-section__title">{{ 'page.my_recipes_list'|trans }}</h2>
            </div>
            <div class="home-section__body">
                {% include "security/account/recipe-list.html.twig" with {
                    recipes: recipes,
                    countRepeat: 1,
                } %}
            </div>
        </section>
    {% else %}
        <div class="page-empty">
            <div class="page-empty__icon" aria-hidden="true">
                <i class="bi bi-journal-plus"></i>
            </div>
            <h3 class="page-empty__title">{{ "You don't have any recipes yet"|trans }}</h3>
            <p class="page-empty__text">{{ 'page.my_recipes_empty_hint'|trans }}</p>
            <button
                type="button"
                data-add-url="{{ path('add_recipe', {_locale: app.request.locale}) }}"
                data-action="click->scroll#addRecipe"
                class="btn btn-primary page-form__submit"
            >
                <i class="bi bi-plus-lg me-2"></i>{{ 'Add new recipe'|trans }}
            </button>
        </div>
    {% endif %}
</div>
{% endblock %}


{% set setting = site_settings() %}
{% extends "base-account.html.twig" %}
{% block main %}
    <div class="width-search d-flex justify-content-between align-items-center">
        <button type="button"
                data-add-url="{{path('add_recipe', {_locale: app.request.locale})}}"
                data-action="click->scroll#addRecipe"
                class="my-3 btn btn-sm btn-primary text-center"
        >
            {{ 'Add new recipe'|trans }}
        </button>
    </div>

    {% if recipes is not empty %}
        <div class="width-search d-flex justify-content-between align-items-center">
            <h4 class="fw-bold ms-2 my-3">{{'Your recipes'|trans}}</h4>
        </div>
        {% include "security/account/recipe-list.html.twig" with {
            'recipes': recipes,
            'countRepeat': 1
        } %}
    {% else %}
        <h5 class="text-center">{{ "You don't have any recipes yet"|trans }}</h5>
    {% endif %}
{% endblock %}

{% set setting = site_settings() %}
<div class="container-fluid container__header">
    <div class="container">
        <header class="d-flex flex-wrap justify-content-between justify-content-md-center align-items-center py-1 py-md-3 mb-0">
            <a href="{{ absolute_url(path('homepage')) }}"
                class="d-flex align-items-center mb-0 me-md-auto  text-decoration-none">
                <img src="{{ absolute_url(asset('uploads/logo/logo.png')) }}"
                    alt="" width="50" height="auto"
                    style="vertical-align:middle; margin-right:8px;">
                <span class="fs-desktop-4 lh-50 text-uppercase text-white">{{ setting.header.title }}</span>
            </a>
            <nav class="navbar navbar-expand-md navbar-light bg-green">
                <div class="position-relative">
                    <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div data-controller="navbar" class="collapse navbar-collapse dropdown-popup" id="mainNavbar">
                            <ul class="navbar-nav ms-auto">
                                {% for item_menu in setting.menu %}
                                    {% if item_menu.megamenutype =='Link' or item_menu.megamenutype =='Form'  %}
                                        <li class="nav-item">
                                            <a href="{{ absolute_url(path(item_menu.url)) }}"
                                               class="ps-3 lh-m-50 p-m-0 nav-link text-white text-decoration-none {% if item_menu.url in app.request.get('_route') %}active {% endif %}">
                                                {{ item_menu.name }}
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                                {% for item_menu in setting.menu %}
                                    {% if item_menu.megamenutype =='Collection' %}
                                        <li class="nav-item dropdown mega-dropdown position-static">
                                            <a class="nav-link ps-3 dropdown-toggle text-white text-decoration-none dropdown-toggle"
                                               href="#"
                                               role="button"
                                               data-bs-toggle="dropdown"
                                               aria-expanded="false">
                                                {{ item_menu.name }}
                                            </a>
                                            {% include "megamenu-collection.html.twig" with {
                                                content: item_menu.content,
                                                url_key: setting.menu_url_key
                                            } %}
                                        </li>
                                    {% endif %}
                                {% endfor %}
                                <li class="nav-item">
                                    {% if app.user %}
                                        <a href="{{ path('app_logout') }}" class="ps-3 nav-link text-white text-decoration-none {% if 'login' in app.request.get('_route') %}active {% endif %}">
                                            {{ 'Logout'|trans }}
                                        </a>
                                    {% else %}
                                        <a href="{{ path('app_login') }}" class="ps-3 nav-link text-white text-decoration-none {% if 'login' in app.request.get('_route') %}active {% endif %}">
                                            {{ 'Login'|trans }}
                                        </a>
                                    {% endif %}
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="ps-3 nav-link text-white text-decoration-none dropdown-toggle" href="#" id="dropdown-language" role="button"
                                       data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        {{ app.request.locale|upper }}
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end p-1" aria-labelledby="dropdown-language">
                                        <li class="list-group-item p-1">
                                            <a class="text-dark-custom text-decoration-none dropdown-item {% if app.request.locale == 'en' %} active {% endif %}"
                                               href="{{ path('switch_language', {_locale: 'en'}) }}">
                                                {{ 'English'|trans }}
                                            </a>
                                        </li>
                                        <li class="list-group-item p-0">
                                            <a class="text-dark-custom text-decoration-none dropdown-item {% if app.request.locale == 'uk' %} active {% endif %}"
                                               href="{{ path('switch_language', {_locale: 'uk'}) }}">
                                                {{ 'Ukrainian'|trans }}
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                    </div>
                </div>
            </nav>
        </header>
    </div>
</div>

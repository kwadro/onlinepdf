{% set setting = site_settings() %}
<div class="container-fluid container__header">
    <div class="container">
    <header class="d-flex flex-wrap justify-content-center align-items-center py-3 mb-0">
        <a href="{{ absolute_url(path('homepage')) }}"
           class="d-flex align-items-center mb-3 mb-md-0 me-md-auto  text-decoration-none">
            <img src="{{ absolute_url(asset('uploads/logo/logo.png')) }}"
                 alt="" width="50" height="auto"
                 style="vertical-align:middle; margin-right:8px;">
            <span class="fs-4 text-uppercase text-white">{{ setting.header.title }}</span>
        </a>
        <nav class="navbar navbar-light">
            <div class="container position-relative">
                <ul class="nav nav-pills d-none d-md-flex">
                    {% for item_menu in setting.menu %}
                        {% if item_menu.megamenutype =='Link' or item_menu.megamenutype =='Form'  %}
                            <li class="nav-item">
                                <a href="{{ absolute_url(path(item_menu.url)) }}"
                                   class="nav-link text-white text-decoration-none {% if item_menu.url in app.request.get('_route') %}active {% endif %}">
                                    {{ item_menu.name }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                    {% for item_menu in setting.menu %}
                        {% if item_menu.megamenutype =='Collection' %}
                            <li class="nav-item dropdown mega-dropdown ">
                                <a class="nav-link text-white text-decoration-none dropdown-toggle"
                                   href="#"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    {{ item_menu.name }}
                                </a>
                                {% include "megamenu-collection.html.twig" with {
                                    content: item_menu.content,
                                    url_key: setting.menu_url_key
                                } %}
                            </li>
                        {% endif %}
                    {% endfor %}
                    <li class="nav-item">
                        {% if app.user %}
                            <a href="{{ path('app_logout') }}" class="nav-link text-white text-decoration-none {% if 'login' in app.request.get('_route') %}active {% endif %}">
                                {{ 'Logout'|trans }}
                            </a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="nav-link text-white text-decoration-none {% if 'login' in app.request.get('_route') %}active {% endif %}">
                                {{ 'Login'|trans }}
                            </a>
                        {% endif %}
                    </li>
{#                    <li class="nav-item">#}
{#                        <a href="{{ path('admin') }}" class="nav-link {% if 'admin' in app.request.get('_route') %}active {% endif %}">#}
{#                            {{ 'Admin Panel'|trans }}#}
{#                        </a>#}
{#                    </li>#}
                    {#            <li class="nav-item"><a href="#" class="nav-link">Pricing</a></li> #}
                    {#            <li class="nav-item"><a href="{{ path('smtp-mailer') }}" class="nav-link">Smtp Mailer</a></li> #}

                    <li class="nav-item dropdown">
                        <a class="nav-link text-white text-decoration-none dropdown-toggle" href="#" id="dropdown-language" role="button"
                           data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            {{ app.request.locale|upper }}
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end p-1" aria-labelledby="dropdown-language">
                            <li class="list-group-item p-1">
                                <a class="text-dark-custom text-decoration-none dropdown-item {% if app.request.locale == 'en' %} active {% endif %}"
                                   href="{{ path('switch_language', {_locale: 'en'}) }}">
                                    {{ 'English'|trans }}
                                </a>
                            </li>
                            <li class="list-group-item p-0">
                                <a class="text-dark-custom text-decoration-none dropdown-item {% if app.request.locale == 'uk' %} active {% endif %}"
                                   href="{{ path('switch_language', {_locale: 'uk'}) }}">
                                    {{ 'Ukrainian'|trans }}
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

    </header>
    </div>
</div>

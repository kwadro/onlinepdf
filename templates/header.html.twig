{% set setting = site_settings() %}
<header class="site-header container__header">
    <div class="container site-header__container">
        <div class="site-header__inner">
            <a href="{{ absolute_url(path('homepage')) }}" class="site-header__brand">
                <span class="site-header__logo-wrap">
                    <img
                        src="{{ absolute_url(asset('uploads/logo/logo.png')) }}"
                        alt="{{ setting.header.title }}"
                        class="site-header__logo"
                        width="44"
                        height="44"
                    >
                </span>
                <span class="site-header__title">{{ setting.header.title }}</span>
            </a>

            <nav class="site-header__nav navbar navbar-expand-md" aria-label="{{ 'sidebar.navigation'|trans }}">
                <button
                    class="site-header__toggle navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation"
                >
                    <span class="site-header__toggle-bar"></span>
                    <span class="site-header__toggle-bar"></span>
                    <span class="site-header__toggle-bar"></span>
                </button>

                <div data-controller="navbar" class="collapse navbar-collapse site-header__menu dropdown-popup" id="mainNavbar">
                    {% include 'header/nav-links.html.twig' %}

                    {% include 'header/mobile-account-nav.html.twig' %}
                </div>
            </nav>

            <div class="site-header__actions d-none d-md-flex">
                {% if app.user %}
                    <a
                        class="site-header__account dropdown-toggle"
                        href="#"
                        id="dropdown-account"
                        role="button"
                        data-bs-toggle="dropdown"
                        aria-haspopup="true"
                        aria-expanded="false"
                    >
                        {% if app.user.avatarUrl %}
                            {% set avatarSrc = 'http' in app.user.avatarUrl ? app.user.avatarUrl : '/uploads/avatars/' ~ app.user.avatarUrl %}
                            <img
                                id="user-header-image"
                                class="site-header__avatar"
                                src="{{ avatarSrc }}"
                                alt="{{ 'Account'|trans }}"
                                title="{{ 'Account'|trans }}"
                                width="36"
                                height="36"
                            >
                        {% else %}
                            <span class="site-header__account-fallback">{{ 'Account'|trans }}</span>
                        {% endif %}
                    </a>
                    {% include 'security/account-menu.html.twig' %}
                {% else %}
                    <a href="{{ path('app_login') }}" class="site-header__cta btn btn-primary {% if 'login' in app.request.get('_route') %}is-active{% endif %}">
                        {{ 'Login'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</header>

{% set setting = site_settings() %}
<div class="container">
    <header class="d-flex flex-wrap justify-content-center align-items-center py-3 mb-4 border-bottom">
        <a href="{{ absolute_url(path('homepage')) }}"
           class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-dark text-decoration-none">
            <img src="{{ absolute_url(asset('uploads/logo/logo.png')) }}"
                 alt="" width="100" height="auto"
                 style="vertical-align:middle; margin-right:8px;">
            <span class="fs-4">{{ setting.header.title }}</span>
        </a>
        <nav class="navbar navbar-light bg-white">
            <div class="container position-relative">
                <ul class="nav nav-pills">
                    {% for item_menu in setting.menu %}
                        {% if item_menu.megamenutype =='Link' %}
                            <li class="nav-item">
                                <a href="{{ absolute_url(path(item_menu.url)) }}"
                                   class="nav-link {% if item_menu.url in app.request.get('_route') %}active {% endif %}">
                                    {{ item_menu.name }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                    {% for item_menu in setting.menu %}
                        {% if item_menu.megamenutype =='Collection' %}
                            <li class="nav-item dropdown mega-dropdown">
                                <span class="nav-link  {% if item_menu.url in app.request.get('_route') %}active {% endif %}">
                                    {{ item_menu.name }}
                                </span>
                                {% include "megamenu-collection.html.twig" with {
                                    content: item_menu.content,
                                    url_key: setting.menu_url_key
                                } %}
                            </li>
                        {% endif %}
                    {% endfor %}
                    <li class="nav-item">
                        <a href="{{ path('app_register') }}" class="nav-link {% if 'register' in app.request.get('_route') %}active {% endif %}">
                            {{ 'Register'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_login') }}" class="nav-link {% if 'login' in app.request.get('_route') %}active {% endif %}">
                            {{ 'Login'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin') }}" class="nav-link {% if 'admin' in app.request.get('_route') %}active {% endif %}">
                            {{ 'Admin Panel'|trans }}
                        </a>
                    </li>
                    {#            <li class="nav-item"><a href="#" class="nav-link">Pricing</a></li> #}
                    {#            <li class="nav-item"><a href="{{ path('smtp-mailer') }}" class="nav-link">Smtp Mailer</a></li> #}

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="dropdown-language" role="button"
                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            {{ app.request.locale|upper }}
                        </a>

                        <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdown-language">
                            <li>
                                <a class="dropdown-item {% if app.request.locale == 'en' %} active {% endif %}"
                                   href="{{ path('switch_language', {_locale: 'en'}) }}">
                                    {{ 'English'|trans }}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item {% if app.request.locale == 'uk' %} active {% endif %}"
                                   href="{{ path('switch_language', {_locale: 'uk'}) }}">
                                    {{ 'Ukrainian'|trans }}
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
</div>

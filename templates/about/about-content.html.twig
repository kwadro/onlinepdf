<div class="page-content">
    <section class="page-hero">
        <div class="page-hero__icon" aria-hidden="true">
            <i class="bi bi-info-circle"></i>
        </div>
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ breadcrumbs|last.name|default('About the Project'|trans) }}</h1>
            <p class="page-hero__subtitle">{{ 'page.about_intro'|trans }}</p>
        </div>
    </section>

    <div class="page-card page-prose">
        {{ content|raw }}
    </div>
</div>

<div class="container my-4"
     data-controller="search"
     data-ajaxurl="{{ searchAjaxUrl|default('empty') }}"
>
    <div class="d-flex justify-content-center">
        <input id="search_form" type="hidden" name="_token" value="{{ csrf_token_search }}">
        <div class="input-group search-box">
            <input
                id="search-input"
                type="text"
                class="form-control"
                placeholder="{{ 'search_placeholder'|trans }}"
            >
            <button
                class="btn btn-warning px-4"
                data-action="click->search#open"
                type="button">
                {{ 'Find a recipe'|trans }}
            </button>
        </div>
    </div>
</div>

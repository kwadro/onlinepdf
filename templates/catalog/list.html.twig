{% set setting = site_settings() %}
{% extends "base.html.twig" %}
{% block title %} {{ 'Recipes'|trans }}{% endblock %}
{% block main %}
    {% include "recipe/breadcrumbs.html.twig" with {
        breadCrumbs: breadcrumbs
    } %}
    {% set menu_url_key = setting.menu_url_key | default('catalog') %}
    <div class="container py-5">
        <div class="row d-flex justify-content-between align-items-center mb-1">
                <div class="col-12 col-md-3">
                    <h4 class="mb-0 text-center">{{ 'Recipes Collection'|trans }}</h4>
                </div>
                <div class="col-12 col-md-9">
                    {% include "catalog/search.html.twig" with {
                        lastSearch: []
                    } %}
                </div>
        </div>
        <div class="selected-filter d-flex justify-content-between align-items-center mb-3"
             data-controller="filter"
        >
            {% include "catalog/filter.html.twig" with {
                categories: [],
                authors: []
            } %}
        </div>

        <div class="row g-4">
            <!-- Filters Sidebar -->
            <div class="col-lg-3">
                <div class="filter-sidebar p-4 shadow-sm"
                     data-controller="filtercategory"
                     data-ajaxurl="{{ filterAjaxUrl }}"
                >
                    {% if recipeCategories is not empty %}
                        <div class="filter-group categories">
                            <input id="filter_form" type="hidden" name="_token" value="{{ csrf_token }}">
                            <h6 class="mb-3">{{ 'Categories'|trans }}</h6>
                            {% for recipeCategory in recipeCategories %}
                                <div class="form-check mb-2"
                                    data-childid="#collapse-{{ recipeCategory.id }}"
                                >
                                    <input
                                        data-level="1"
                                        name="category[]"
                                        class="form-check-input"
                                        type="checkbox"
                                        id="category-{{ recipeCategory.id }}"
                                    >
                                    <label class="form-check-label" for="category-{{ recipeCategory.id }}">
                                        {{ recipeCategory.name }}
                                    </label>
                                    {% if recipeCategory.children is not empty %}
                                        <div class="collapse-test" id="collapse-{{ recipeCategory.id }}">
                                        {% for childrenCategory in recipeCategory.children %}
                                            <div class="form-check mb-2">
                                                <input data-level="2" name="category[]" class="form-check-input" type="checkbox" id="category-{{ childrenCategory.id }}">
                                                <label class="form-check-label" for="category-{{ childrenCategory.id }}">
                                                    {{ childrenCategory.name }}
                                                </label>
                                            </div>
                                        {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if recipeAuthors is not empty %}
                    <div class="filter-group">
                        <h6 class="mb-3">{{ 'Authors'|trans }}</h6>
                        {% for recipeAuthor in recipeAuthors %}
                            <div class="form-check mb-2">
                                <input name="author[]" class="form-check-input" type="checkbox" id="author-{{ recipeAuthor.id }}">
                                <label class="form-check-label" for="author-{{ recipeAuthor.id }}">
                                    {{ recipeAuthor.name }}
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                    <button class="btn btn-outline-primary w-100">Reset Filters</button>
                </div>
            </div>
            <!-- Product Grid -->
            <div class="product-grid col-lg-9">
                {% include "catalog/products-grid.html.twig" with {
                    recipes: recipes
                } %}
            </div>
        </div>
    </div>
{% endblock %}



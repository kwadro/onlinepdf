{% extends "base.html.twig" %}
{% block title %}Рецепти{% endblock %}
{% block main %}
    {% include "recipe/breadcrumbs.html.twig" with {
        breadcrumbs: breadcrumbs
    } %}
    <div class="container">
        <div class="row ">
            <div class="col">
                <h3 class="my-1 text-center card-title">{{ recipeCategory.name }}</h3>
                {% if recipeCategory.image %}
                    <img src="/uploads/recipes/{{recipeCategory.image }}"
                        class="card-img-top"
                        style=" object-fit:cover;">
                {% endif %}

            </div>
            <div class="col">
            <ul class="list-group ">
            {% for recipe in recipes %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>{{ recipe.translations[0].name }}</span>
                    <a href="{{ path('catalog_show', {urlKey: recipe.translations[0].slug}) }}" class="btn btn-sm btn-primary">
                        {{ 'View'|trans }}
                    </a>
                </li>
            {% endfor %}
            </ul>
            </div>
        </div>
    </div>
{% endblock %}


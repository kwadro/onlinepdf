{% extends "base.html.twig" %}
{% block title %}Рецепти{% endblock %}
{% block main %}
    {% include "recipe/breadcrumbs.html.twig" with {
        breadcrumbs: breadcrumbs
    } %}
    <div class="container">
        {% if recipeCategory.children is not empty %}
            <div class="row my-3 children-category">
                <div class="col ">
                    <h3 class="mb-3 text-center">{{ 'Categories'|trans }}</h3>
                    <div class="d-flex flex-wrap gap-2 align-center justify-content-center">
                        {% for child in recipeCategory.children %}
                            <a class="d-block px-3 py-2 text-center rounded text-decoration-none text-dark border hover-shadow"
                               href="{{ absolute_url('/' ~ app.request.locale ~ '/catalog' ~ url_key ~ '/' ~ child.slug) }}">
                                {{ child.name }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="row my-3 ">
            <div class="col">
                <h3 class="my-1 text-center card-title">{{ recipeCategory.name }}</h3>
                {% if recipeCategory.image %}
                    <img src="/uploads/recipes/{{recipeCategory.image }}"
                        class="card-img-top"
                        style=" object-fit:cover;">
                {% endif %}
            </div>

            <div class="col">
                {% if recipes is not empty %}
                    <h3 class="text-center">{{ 'List of recipes'|trans }}</h3>

                    <ul class="list-group ">
                    {% for recipe in recipes %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="col-10 text-start">
                                <div class="row">
                                    <p>{{ recipe.recipetranslations[0].name }}</p>
                                </div>
                                <div class="d-flex gap-2 text-muted flex-row small">
                                    <span data-bs-toggle="tooltip" title="{{ 'Prepare time'|trans }}">
                                        <i class="me-1 bi bi-clock"></i>{{ recipe.prepTimeMin }} {{ 'minutes'|trans }}
                                    </span>
                                    <span data-bs-toggle="tooltip" title="{{ 'Cook time'|trans }}">
                                        <i class="me-1 bi bi-fire"></i>{{ recipe.cookTimeMin }} {{ 'minutes'|trans }}
                                    </span>
                                    <span data-bs-toggle="tooltip" title="{{ 'Servings'|trans }}">
                                        <i class="me-1 bi bi-people"></i>{{ recipe.servings }}
                                    </span>
                                </div>
                                <div class="flex-row small">
                                    <span>{{ 'Author'|trans }}</span>
                                    <a href="{{ path('author_list', {id: recipe.recipetranslations[0].recipeauthor.id}) }}" class="btn btn-sm btn-secondary">
                                        {{ recipe.recipetranslations[0].recipeauthor }}
                                    </a>

                                </div>
                            </div>
                            <div class="col-2 text-end">
                                <a href="{{ path('catalog_show', {urlKey: recipe.recipetranslations[0].slug}) }}" class="btn btn-sm btn-primary">
                                    {{ 'View'|trans }}
                                </a>
                            </div>
                        </li>
                    {% endfor %}
                    </ul>
                {% else %}
                    <h5 class="text-center">{{ 'We not found any recipe in this category'|trans }}</h5>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}


{%- raw %}
<div class="container container__contact">
    <section class="d-flex flex-wrap justify-content-left py-3 mb-4 border-bottom">
        <h1 class="w-100 mb-4">{{ 'Contact'|trans }}</h1>
    </section>
    <section class="d-flex flex-wrap justify-content-left py-3 mb-4 border-bottom">

        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {{ form_start({%- endraw %}{{ entityClass }}{%- raw %}) }}
                    {{ form_row({%- endraw %}{{ entityClass }}{%- raw %}.name , {'attr': {'class': 'mb-1 form-control name'}}) }}
                    {{ form_row({%- endraw %}{{ entityClass }}{%- raw %}.email, {'attr': {'class': 'mb-1 form-control email'}}) }}
                    {{ form_row({%- endraw %}{{ entityClass }}{%- raw %}.message,{'attr': {'class': 'mb-1 form-control message'}}) }}
                    <button type="submit" class="mt-3 btn btn-primary">Send Message</button>
                    {{ form_end({%- endraw %}{{ entityClass }}{%- raw %}) }}
                </div>
            </div>
        </div>
    </section>
</div>
{%- endraw %}



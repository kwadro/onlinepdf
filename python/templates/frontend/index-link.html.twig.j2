{%- raw %}
{% set setting = site_settings() %}
{% extends "base.html.twig" %}
{% block main %}
       {% include "recipe/breadcrumbs.html.twig" with {
         breadCrumbs: breadcrumbs
       } %}
       {% include "{%- endraw %}{{ name }}/{{ name }}{%- raw %}-content.html.twig" with {
           content: setting.menu_pages.{%- endraw %}{{ name }}{%- raw %}.content
       } %}
{% endblock %}
{%- endraw %}

<?php

namespace App\Form\Type;

use App\Entity\{{ name }};
use Symfony\Component\Form\AbstractType;
use Symfony\Bridge\Doctrine\Form\Type\EntityType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\Extension\Core\Type\TextareaType;
use Symfony\Component\Form\Extension\Core\Type\IntegerType;
use Symfony\Component\Form\Extension\Core\Type\ChoiceType;
use Symfony\Component\Form\Extension\Core\Type\CollectionType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolver;
{%- for field in fields %}
{%- if field.type == 'relation' and field.objectRelation != 'self'  %}
use App\Form\Type\{{ field.objectRelation }}Type;
{%- endif %}
{%- if field.type == 'relation' and (field.typeInput == 'addNew' or field.typeInput == 'addNew1')  %}
use App\Entity\{{ field.objectRelation }};
{%- endif %}
{%- endfor %}
class {{ name }}Type extends AbstractType
{
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
        {%- for field in fields %}
            {%- if field.id or field.hideOnForm or (field.admin is defined and field.admin == false) or field.type == 'relation' %}
            {%- else %}
            {%- if field.type=='string' %}
            ->add('{{field.name}}', TextType::class)
            {%- endif %}
            {%- if field.type=='text' and field.typeInput in ['tinymce', 'tinymce_email'] %}
            {% set tinymce_class = 'tinymce tinymce-email' if field.typeInput == 'tinymce_email' else 'tinymce' %}
            ->add('{{field.name}}', TextareaType::class, [
                'attr' => ['class' => '{{ tinymce_class }}'],
            ])
            {%- endif %}
            {%- if field.type=='text' and not field.typeInput %}
            ->add('{{field.name}}', TextareaType::class)
            {%- endif %}
            {%- if field.type=='text' and field.typeInput and field.typeInput not in ['tinymce', 'tinymce_email'] %}
            ->add('{{field.name}}', TextareaType::class)
            {%- endif %}
            {%- if field.type=='integer' %}
            ->add('{{field.name}}', IntegerType::class)
            {%- endif %}
            {%- if field.type=='select' and field.typeInput=='yesno' %}
            ->add('{{field.name}}', ChoiceType::class,[
                'choices' => [
                    'Yes' => 'Yes',
                    'No' => 'No'
                ]
            ])
            {%- endif %}
            {%- if field.type=='select' and field.typeInput=='choices' %}
            ->add('{{field.name}}', ChoiceType::class, [
                'choices' => [
                {%- for value, label in field.choices.items() %}
                    '{{ label }}' => '{{ value }}',
                {%- endfor %}
                ],
                {%- if field.help %}
                'help' => '{{ field.help }}',
                {%- endif %}
            ])
            {%- endif %}

            {%- if field.type == 'relation' and field.typeInput=='addNews'  %}
            ->add('{{field.name}}', CollectionType::class, [
                'entry_type' => {{field.objectRelation}}Type::class,
                'entry_options' => [
                    'label' => false,
                ],
                'allow_add' => true,
                'allow_delete' => true,
                'by_reference' => false,
                'prototype' => true,
            ])
            {%- endif %}

            {%- if field.type == 'relation' and field.typeInput == 'addNew' %}
                {%- set parts = field.formSetting.split('|') %}
                 ->add('{{field.name}}', CustomAddselectType::class, [
                     'class' => {{ field.objectRelation }}::class,
                     'choice_label' => 'name',
                     'placeholder' => 'Select {{ field.name|lower }}',
                     'required' => true,
                     'attr' => [
                         'data-entity' => '{{ field.objectRelation }}',
                         'search-field'=>'{{parts[0]}}',
                         'require-fields'=>'{{parts[1]}}',
                     ],

                 ])
            {%- endif %}
            {%- endif %}
        {%- endfor %}
         ;
    }

    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => {{ name }}::class,
            'csrf_protection' => true,
            'csrf_field_name' => '_token',
            'csrf_token_id'   => '{{ name | lower }}_form',
        ]);
    }
}
